{
  "html": {
    "body": {
      "components": [
        {
          "data": {
            "freight_conditions": {
              "function": "get_freight_conditions"
            },
            "payment_conditions": {
              "function": "get_payment_conditions"
            }
          },
          "type": "template",
          "template": "shared/components/banner/stripe.liquid"
        },
        {
          "tag": "header",
          "type": "container",
          "class": "ora-headbar",
          "components": [
            {
              "type": "template",
              "template": "shared/components/header/index.liquid",
              "data": {
                "categories": {
                  "function": "get_category_tree"
                }
              }
            },
            {
              "type": "template",
              "template": "shared/components/header/components/floating-bar/index.liquid",
              "properties": {
                "show_back_button": true
              }
            },
            {
              "type": "template",
              "template": "shared/components/header/components/segmented-price/index.liquid"
            }
          ]
        },
        {
          "tag": "main",
          "type": "container",
          "components": [
            {
              "data": {
                "banners": {
                  "args": {
                    "location": "extra",
                    "position": "full"
                  },
                  "function": "get_banners"
                }
              },
              "type": "template",
              "template": "shared/components/banner/index.liquid",
              "properties": {
                "position": "full"
              }
            },
            {
              "data": {
                "banners": {
                  "args": {
                    "location": "extra",
                    "position": "stripe"
                  },
                  "function": "get_banners"
                }
              },
              "type": "template",
              "template": "shared/components/banner/index.liquid",
              "properties": {
                "position": "stripe"
              }
            },
            {
              "data": {
                "banners": {
                  "args": {
                    "location": "extra",
                    "position": "mini"
                  },
                  "function": "get_banners"
                }
              },
              "type": "template",
              "template": "shared/components/banner/index.liquid",
              "properties": {
                "position": "mini"
              }
            },
            {
              "type": "template",
              "template": "content/institutional-page.liquid"
            },
            {
              "type": "template",
              "template": "components/space.liquid",
              "properties": {
                "class": "h-10 lg:h-20"
              }
            },
            {
              "data": {
                "banners": {
                  "args": {
                    "location": "extra",
                    "position": "showcase"
                  },
                  "function": "get_banners"
                }
              },
              "type": "template",
              "template": "shared/components/banner/index.liquid",
              "properties": {
                "position": "showcase"
              }
            }
          ]
        },
        {
          "tag": "footer",
          "type": "container",
          "class": "ora-footer",
          "components": [
            {
              "data": {
                "store": {
                  "function": "get_store"
                },
                "categories": {
                  "function": "get_category_tree"
                },
                "payment_conditions": {
                  "function": "get_payment_conditions"
                },
                "institutional_pages": {
                  "function": "get_institutional_pages"
                }
              },
              "type": "template",
              "template": "shared/components/footer/container.liquid"
            },
            {
              "type": "template",
              "template": "shared/components/footer/closing.liquid"
            }
          ]
        },
        {
          "type": "template",
          "template": "shared/utils/index.liquid"
        }
      ]
    },
    "head": {
      "components": [
        {
          "type": "template",
          "template": "shared/components/head/style-general.liquid"
        },
        {
          "type": "template",
          "template": "shared/components/head/seo.liquid"
        },
        {
          "type": "template",
          "template": "shared/components/head/script-general.liquid"
        }
      ]
    }
  },
  "path": "/[institutional-page]",
  "$schema": "https://cdn.awsli.com.br/public/render/schema/v1.json",
  "_version": "3",
  "global_data": {
    "institutional_page": {
      "function": "get_institutional_page"
    }
  }
}