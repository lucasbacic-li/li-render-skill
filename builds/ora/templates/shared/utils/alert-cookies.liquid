      <p class="grow text-sm text-base-content leading-tight text-center md:text-left">
        Utilizamos cookies para que você tenha a melhor experiência em nosso site.
        {% if politica_privacidade %}
          Para saber mais acesse nossa página de
          <a href="/pagina/{{ politica_privacidade.url }}" target="_blank" class="font-bold hover:underline">Política de Privacidade</a>.
        {% endif %}
      </p>
      <button type="button" class="btn btn-primary shrink-0" onclick="this.closest('cookie-alert').onClose()">
        Entendi
        <svg class="size-4 fill-current text-primary-content ml-1 -mr-1" role="img" aria-hidden="true">
          <use xlink:href="/static/img/fontawesome-solid.svg#circle-check" href="/static/img/fontawesome-solid.svg#circle-check"></use>
        </svg>
      </button>
    </div>
  {% else %}
    <cookie-alert class="fixed bottom-5 left-1/2 -translate-x-1/2 z-50 max-w-4xl w-full hidden transition-discrete" data-policy-updated-date="{{ layout_attributes.configuracao.politica_privacidade_pagina_modificacao }}">
      <div hx-trigger="intersect once" hx-get="/partial/alert/cookies-accept" hx-select=".alert_cookies_accept" hx-swap="outerHTML"></div>
    </cookie-alert>
    <script defer src="{% asset_url '/scripts/cookie-alert.webc.js' %}"></script>
  {% endif %}
{% endif %}
