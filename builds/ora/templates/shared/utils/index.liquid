{% render 'shared/utils/alert-cookies' %}
{% render 'shared/utils/toast' %}

{% if layout_attributes.newsletter.boxnews_popup or layout_attributes.newsletter.boxnews_barra %}
  {% render 'shared/components/newsletter/popup', async: true %}
  <script defer src="{% asset_url '/scripts/newsletter-subscribe.webc.js' %}"></script>
{% endif %}

<script>
  document.addEventListener('htmx:responseError', function (evt) {
    console.log(evt)
    window.toast('Falha ao executar ação. Tente novamente', {type: 'danger'});
  });
</script>
