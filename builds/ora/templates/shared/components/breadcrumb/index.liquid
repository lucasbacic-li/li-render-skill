{%- assign position = props.position | default: 'left' -%}
{%- assign categories_tree = data.product.main_category -%}
{% unless categories_tree %}
  {%- assign categories_tree = data.category.parent_tree -%}
{% endunless %}
{%- assign current_page = data.product.name | default: data.category.name | default: data.brand.name | default: ctx.url.querystring.q | default: ctx.url.path | default: '' -%}
<div class="{% if position == 'col' %}md:col-start-2 md:row-start-1{% else %}container py-3 md:pt-6{% endif %}">
  <nav aria-label="breadcrumb" role="navigation" class="breadcrumbs relative flex text-sm text-base-content py-1 scrollbar-thin">
    <ul class="flex-1 {% if position == 'center' %}justify-center md:justify-start {% endif %}">
      <li>
        <a title="Ir para a página inicial" href="/" class="block hover:text-primary">
          Início
        </a>
      </li>
      {% if categories_tree %}
        {% render 'shared/components/breadcrumb/item', category: categories_tree %}
      {% endif %}
      <li aria-current="page" class="opacity-60">
        {{ current_page }}
      </li>
    </ul>
    <div class="shrink-0 pointer-events-none sticky -right-px top-0 h-5 w-5 bg-neutral mask-l-from-0%"></div>
  </nav>
</div>
