{% if layout_attributes.newsletter.boxnews_barra and layout_attributes.newsletter.boxnews_barra_posicao == 'rodape' %}
  {% if props.async or async %}
    <div
      data-newsletter-box
      hx-get="/partial/newsletter/subscribe"
      hx-select="[data-newsletter-box]"
      hx-trigger="revealed once"
      hx-swap="outerHTML"
    ></div>
  {% else %}
    <div data-newsletter-box class="py-10 border-b border-base-200">
      <div class="container px-5">
        <newsletter-subscribe>
          <div data-newsletter-state></div>
          <div class="flex flex-col gap-5 md:grid md:grid-cols-2 md:items-center md:justify-between md:gap-15">
            <div class="flex flex-col gap-2.5">
              <p class="font-medium text-3xl leading-9 text-base-content">{{ props.title | default: layout_attributes.newsletter.boxnews_titulo | default: 'Receba novidades e ofertas!' }}</p>
              <p class="text-base text-base-content">{{ props.subtitle | default: layout_attributes.newsletter.boxnews_intro | default: 'Fique por dentro do que acontece na loja, receba cupons e ofertas direto em seu e-mail.' }}</p>
            </div>
            <p class="newsletter-success-message text-center text-base text-success py-4 px-6 bg-base-100 border border-base-200 rounded-md hidden" aria-hidden="true"></p>
            <form
              method="post"
              hx-post="{{ routes.marketing_newsletter_subscribe }}"
              hx-target="[data-newsletter-state]"
              hx-indicator="find [data-newsletter-spinner]"
              hx-swap="innerHTML"
              class="newsletter-subscribe-form relative"
            >
              <div class="relative w-full">
                <input
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                  class="input input-neutral input-md px-6 pr-16 w-full"
                  placeholder="{{ props.input_placeholder | default: 'Digite seu e-mail' }}"
                  data-testid="li-newsletter-input"
                />
                <input
                  name="name"
                  type="hidden"
                  placeholder="Digite seu nome"
                  class="input"
                />
                <button type="submit" class="btn btn-ghost px-4 absolute right-0 top-1/2 -translate-y-1/2 z-10" data-testid="li-newsletter-submit">
                  {% comment %} {{ props.button_text | default: 'Inscrever-se' }} {% endcomment %}
                  <svg width="24" height="25" viewBox="0 0 24 25" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <mask id="mask0_457_2820" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="25">
                    <rect y="0.25" width="24" height="24" fill="#D9D9D9"/>
                    </mask>
                    <g mask="url(#mask0_457_2820)">
                      <path d="M3 20.25V4.25L22 12.25L3 20.25ZM5 17.25L16.85 12.25L5 7.25V10.75L11 12.25L5 13.75V17.25Z" fill="currentColor"/>
                    </g>
                  </svg>
                </button>
              </div>
              <p class="newsletter-error-message mt-1 text-error text-sm hidden" aria-hidden="true">Falha ao cadastrar. Tente novamente</p>
              <span data-newsletter-spinner class="hidden [&.htmx-request]:flex absolute inset-0 size-full flex-wrap justify-center content-center bg-base-content/10">
                <svg class="fill-current size-8 animate-spin" role="img" aria-hidden="true">
                  <use xlink:href="/static/img/fontawesome-solid.svg#spinner" href="/static/img/fontawesome-solid.svg#spinner"></use>
                </svg>
              </span>
            </form>
          </div>
        </newsletter-subscribe>
      </div>
    </div>
  {% endif %}
{% endif %}
