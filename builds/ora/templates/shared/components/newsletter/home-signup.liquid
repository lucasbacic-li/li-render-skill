{%- comment -%}
  Newsletter (home, acima do rodapé) — faixa Ora: título grotesk + form inline.
  Reaproveita a mecânica da LI: web component <newsletter-subscribe> + form com
  HTMX POST em routes.marketing_newsletter_subscribe, alvo [data-newsletter-state]
  (a resposta dispara li-newsletter-status + toast). O webc alterna .hidden em
  .newsletter-subscribe-form / .newsletter-success-message / .newsletter-error-message.
{%- endcomment -%}
<section class="ora-newsletter">
  <newsletter-subscribe>
    <div data-newsletter-state></div>
    <div class="ora-newsletter__inner">
      <div class="ora-newsletter__head">
        <h2 class="ora-newsletter__title ora-grotesk">{{ props.title | default: layout_attributes.newsletter.boxnews_titulo | default: 'Assine e ganhe 10% na primeira compra' }}</h2>
        {%- assign nl_intro = props.subtitle | default: layout_attributes.newsletter.boxnews_intro -%}
        {%- if nl_intro -%}<p class="ora-newsletter__intro">{{ nl_intro }}</p>{%- endif -%}
      </div>

      <div class="ora-newsletter__action">
        <p class="newsletter-success-message ora-newsletter__success hidden" aria-hidden="true"></p>
        <form
          method="post"
          hx-post="{{ routes.marketing_newsletter_subscribe }}"
          hx-target="[data-newsletter-state]"
          hx-indicator="find [data-newsletter-spinner]"
          hx-swap="innerHTML"
          class="newsletter-subscribe-form ora-newsletter__form"
        >
          <input
            name="email"
            type="email"
            autocomplete="email"
            required
            class="ora-newsletter__input"
            placeholder="{{ props.input_placeholder | default: 'seu melhor e-mail' }}"
            aria-label="Seu melhor e-mail"
            data-testid="li-newsletter-input"
          />
          <input name="name" type="hidden" />
          <button type="submit" class="ora-cta ora-newsletter__cta" data-testid="li-newsletter-submit">
            <span class="ora-cta__label">{{ props.button_text | default: 'Assinar' }}</span>
            <span class="ora-cta__box">
              <svg role="img" aria-hidden="true">
                <use xlink:href="/static/img/fontawesome-solid.svg#arrow-right" href="/static/img/fontawesome-solid.svg#arrow-right"></use>
              </svg>
            </span>
          </button>
          <span data-newsletter-spinner class="ora-newsletter__spinner" aria-hidden="true">
            <svg class="fill-current size-6 animate-spin" role="img" aria-hidden="true">
              <use xlink:href="/static/img/fontawesome-solid.svg#spinner" href="/static/img/fontawesome-solid.svg#spinner"></use>
            </svg>
          </span>
        </form>
        <p class="newsletter-error-message ora-newsletter__error hidden" aria-hidden="true">Falha ao cadastrar. Tente novamente.</p>
      </div>
    </div>
  </newsletter-subscribe>
</section>
