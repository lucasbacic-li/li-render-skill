<ul class="component_sac">
  <li class="flex items-center gap-2">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <mask id="mask0_91_4539" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
      <rect width="24" height="24" fill="#D9D9D9"/>
      </mask>
      <g mask="url(#mask0_91_4539)">
      <path d="M2 22V4C2 3.45 2.19583 2.97917 2.5875 2.5875C2.97917 2.19583 3.45 2 4 2H20C20.55 2 21.0208 2.19583 21.4125 2.5875C21.8042 2.97917 22 3.45 22 4V16C22 16.55 21.8042 17.0208 21.4125 17.4125C21.0208 17.8042 20.55 18 20 18H6L2 22ZM5.15 16H20V4H4V17.125L5.15 16Z" fill="currentColor"/>
      </g>
    </svg>
    <a href="/contact-us" class="block text-sm text-base-content leading-10 hover:underline" data-testid="li-contact-us">
      Formulário de contato
    </a>
  </li>
  {% if data.store.email %}
    <li class="flex items-center gap-2">
      {% assign store_email = data.store.email %}
      <svg class="fill-current size-4 mr-2 shrink-0 grow-0" role="img" aria-hidden="true">
        <use xlink:href="/static/img/fontawesome-solid.svg#envelope" href="/static/img/fontawesome-solid.svg#envelope"></use>
      </svg>
      <a href="mailto:{{ store_email }}" class="leading-4 font-semibold hover:underline break-all">
        {{ store_email }}
      </a>
    </li>
  {% endif %}
  {% if data.store.whatsapp or data.store.phone %}
    <li class="flex flex-wrap items-center gap-x-4 mt-2">
      {% if data.store.whatsapp %}
        <a href="https://wa.me/55{{ data.store.whatsapp | only_numbers }}" target="_blank" class="text-sm text-base-content leading-6 flex items-center gap-2 hover:underline">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <mask id="mask0_91_4544" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
              <rect width="24" height="24" fill="#D9D9D9"/>
            </mask>
