{%- assign img_width = img_width | default: '700' -%}
{%- assign img_height = img_height | default: '350' -%}
{%- assign img_url_prefix = ctx.static_domain | append: '/' | append: img_width | append: 'x' | append: img_height -%}
{%- assign img_url_primary = product.preview_images[0] | default: '/0/0/common/product-no-image.gif' -%}
{%- capture additional_classes -%}
  {%- unless product.available %} opacity-60 {% endunless -%}
  {{ product.category_ids | join: ' prod-card-cat-' | prepend: 'prod-card-cat-' }}
{%- endcapture -%}

{%- assign product_buy_url = routes.cart_item | append: '/PRODUCT_ID/add' -%}
{%- if product.skus.size > 1 and product.options.size == 1 -%}
  {%- assign options_param_sep = '..' -%}
  {%- capture product_skus_variation_match -%}
    {
      {%- for sku in product.skus -%}
        {% if sku.available and sku.price.selling > 0 and sku.price.upon_request == false %}
          {%- for variation in sku.variations -%}
            {%- assign variation_id = variation.option.id -%}
            {%- assign variation_name = variation.option.display_name -%}
            {%- assign variation_ref = variation_name | append: options_param_sep | append: variation_id | remove: "'" | remove: '"' -%}
            {%- assign option_ref = variation.value.name | append: options_param_sep | append: variation.value.id | remove: "'" | remove: '"' -%}
            '{{ variation_ref }}{{ options_param_sep }}{{ option_ref }}': '{{ sku.id }}',
          {%- endfor -%}
        {% endif %}
      {%- endfor -%}
    }
  {%- endcapture -%}
{%- endif -%}

<product-card
  class="group isolate flex flex-col relative h-full {{ additional_classes }}"
  data-url="{{ product.url }}"
  data-image-prefix="{{ img_url_prefix }}"
  data-skus="{{ product_skus_variation_match | default: '{}' }}"
  data-buy-url="{{ product_buy_url }}"
>
  <div class="ora-card__cell">
    <div class="ora-card__media">
      {% render 'shared/components/product-card/components/image', product: product, img_url: img_url_primary, img_url_prefix: img_url_prefix, img_height: img_height, forloop: forloop, product_buy_url: product_buy_url %}
      {% render 'shared/components/product-card/components/badges', product: product %}
    </div>
    <div class="ora-card__info">
      {%- comment -%} Preço renderizado uma vez e reusado: linha 1 (largo) ou linha 2 (compacto), alternados por @container. {%- endcomment -%}
      {%- capture card_price -%}{% render 'shared/components/product-card/components/pricing', product: product %}{%- endcapture -%}
      <div class="ora-card__head">
        <span class="ora-card__name">{{ product.name }}</span>
        <span class="ora-card__price">{{ card_price }}</span>
      </div>
      {% appsection shelf_after_product_title %}
      {%- comment -%}
        Só renderiza o wrapper (que tem padding) quando o componente de options
        produz um swatch de fato. options.liquid só mostra seletor para variações
        de COR; variações de outro tipo (ex.: tamanho) saem vazias — sem este
        guard, o .ora-card__opts vazio injetava padding sob o nome.
      {%- endcomment -%}
      {%- capture card_opts -%}{% render 'shared/components/product-card/components/options', product: product %}{%- endcapture -%}
      {%- if card_opts contains '<label' -%}
        <div class="ora-card__opts">{{ card_opts }}</div>
      {%- endif -%}
      <div class="ora-card__buy">
        {%- comment -%} Slot de review do produto — por enquanto exibe o parcelamento (o rating entra aqui depois). {%- endcomment -%}
        {%- assign card_inst = product.price.best_payment_condition.installment -%}
        <div class="ora-card__meta">
          {%- comment -%} Largo: parcelamento (slot de review). Compacto: o preço. {%- endcomment -%}
          <span class="ora-card__installment">
            {%- if card_inst and card_inst.installment_number > 1 -%}
              {{ card_inst.installment_number }}x de {{ card_inst.installment_value | format_number: "C" }}{% if card_inst.no_rate %} sem juros{% endif %}
            {%- endif -%}
          </span>
          <span class="ora-card__price ora-card__price--compact">{{ card_price }}</span>
        </div>
        {%- if product.available and product.price.upon_request == false -%}
          <a
            href="{{ product.url }}"
            data-id="product-buy-url"
            class="ora-card__add relative z-1"
            aria-label="Adicionar {{ product.name }} à sacola"
            {%- if product.options.size == 0 -%}
              hx-post="{{ product_buy_url | replace: 'PRODUCT_ID', product.id }}"
              hx-trigger="click"
            {%- else -%}
              hx-trigger="none"
            {%- endif -%}
            hx-swap="none"
            hx-push-url="false"
          ><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" fill="currentColor" aria-hidden="true"><path d="M446.67-446.67H200v-66.66h246.67V-760h66.66v246.67H760v66.66H513.33V-200h-66.66v-246.67Z"/></svg></a>
        {%- endif -%}
      </div>
    </div>
  </div>
  <a href="{{ product.url }}" data-id="product-url" class="absolute inset-0 w-full h-full z-0" aria-label="Ver {{ product.name }}" data-metrics="select_product" data-mt-prod-position="{{ forloop.index }}" data-mt-prod-id="{{ product.id }}" data-mt-prod-sku="{{ product.code }}" data-mt-prod-name="{{ product.name }}" data-testid="li-shelf-item"></a>
</product-card>


