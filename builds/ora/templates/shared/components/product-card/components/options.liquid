{% if product.options.size > 0 %}
  {% assign options_param_sep = '..' %}
  {% for variation in product.options %}
    {% assign variation_id = variation.option.id %}
    {% assign variation_name = variation.option.display_name %}
    {% assign variation_ref = variation_name | append: options_param_sep | append: variation_id %}
    {% comment %} Apenas seletor de cor {% endcomment %}
    {% if variation_id == '8948' or variation_id == '8945' %}
      <div class="relative z-1 flex flex-wrap gap-2 my-1">
        {% for option in variation.values %}
          {%- if option.disabled -%}
            {% continue %}
          {%- endif -%}
          {%- assign option_ref = option.name | append: options_param_sep | append: option.id -%}
          {%- if option.related_images.size > 0 -%}
            {%- for image in product.images -%}
              {%- if image.id == option.related_images[0] -%}
                {%- assign option_image_related = image.path -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          <label
            class="group relative flex rounded-selector border border-base-200 overflow-hidden text-sm font-medium uppercase tracking-[var(--ora-tracking-caps)] text-nowrap hover:bg-base-300 focus:outline-hidden cursor-pointer bg-base-100 text-base-content shadow-xs has-focus:ring-2 has-focus:ring-primary"
            title="Opção {{ option.name }}"
          >
            <input
              type="radio"
              name="{{ variation_ref }}"
              value="{{ option_ref }}"
              class="peer sr-only"
              aria-labelledby="variation-{{ variation_id }}-choice-{{ option.id }}-label"
              data-image="{{ option_image_related }}"
              data-variation="{{ variation_ref }}{{ options_param_sep }}{{ option_ref }}"
            />
            <span
              id="prod-{{ product.id }}-variation-{{ variation_id }}-choice-{{ option.id }}-label"
              class="{% if option.swatch.color %}sr-only{% endif %}"
            >
              {{ option.name }}
            </span>
            {% if option.swatch.color %}
              <span aria-hidden="true" class="size-0 border-0 border-b-22 border-l-22" style="border-color: {{ option.swatch.color.primary }} {{ option.swatch.color.secondary | default: option.swatch.color.primary }};"></span>
            {% endif %}
            <span class="pointer-events-none absolute -inset-px rounded-selector border-2 border-transparent peer-focus:border peer-checked:border-primary peer-disabled:border-base-300" aria-hidden="true">
            </span>
          </label>
        {% endfor %}
      </div>
    {% endif %}
  {% endfor %}
{% endif %}
