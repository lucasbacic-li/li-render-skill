{%- assign price = product.price -%}
<div class="product-card-price">
  {% if price.upon_request %}
    <span class="text-sm font-medium">Preço sob consulta</span>
  {% elsif product.available %}
    {%- assign price_varies = product.price_varies and product.selected_sku == null -%}
    {% comment %} Card (linha 1): só o preço de venda — sem parcelamento (vai pro slot da linha 2) e sem desconto. 12px mono. {% endcomment %}
    {% render "partials/product-pricing", price: price, price_varies: price_varies, class_default: "text-xs", class_highlight: "text-xs", show_installment: false, show_discount: false %}
  {% else %}
    <span class="text-sm font-medium">Indisponível</span>
  {% endif %}
</div>

