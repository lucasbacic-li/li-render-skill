<div class="ora-footer__inner">
  {%- if layout_attributes.newsletter.boxnews_barra -%}
    {% render 'shared/components/newsletter/bar.liquid', async: true %}
  {%- endif -%}

  {%- comment -%} Faixa superior: brandline (colunas 1–2) + colunas de links {%- endcomment -%}
  <div class="ora-footer__row ora-footer__row--top">
    <div class="ora-footer__cell ora-footer__brand">
      {%- comment -%} Desktop: símbolo · Mobile: wordmark (invertido — ver .ora-closing) {%- endcomment -%}
      <img class="ora-footer__symbol ora-footer__brandmark--symbol" src="{% asset_url 'brand/symbol-espresso.svg' %}" alt="Símbolo Ora" loading="lazy">
      <img class="ora-footer__wordmark-top ora-footer__brandmark--word" src="{% asset_url 'brand/logotype-espresso.svg' %}" alt="Ora" loading="lazy">
      <p class="ora-footer__tagline">
        <span class="ora-serif">A Sua Jornada de</span>
        <span class="ora-grotesk">Reencantamento</span>
      </p>
    </div>

    {% if data.institutional_pages.size > 0 %}
      <div class="ora-footer__cell">
        <h4 class="ora-footer__label">Ajuda</h4>
        <ul class="ora-footer__links">
          {% for page in data.institutional_pages %}
            <li><a class="ora-footer__link" href="/pagina/{{ page.url }}">{{ page.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    {% if data.categories.size > 0 %}
      <div class="ora-footer__cell">
        <h4 class="ora-footer__label">Categorias</h4>
        <ul class="ora-footer__links">
          {% for category in data.categories limit: 8 %}
            <li><a class="ora-footer__link" href="{{ category.path }}">{{ category.name }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

    {% render 'shared/components/footer/social' %}
  </div>

  {%- comment -%} Faixa meta (3 colunas): Contato · Pagamento+selos · Plataforma {%- endcomment -%}
  <div class="ora-footer__row ora-footer__row--meta">
    <div class="ora-footer__cell ora-footer__cell--c1">
      <h4 class="ora-footer__label">Contato</h4>
      <div class="ora-footer__sac" hx-trigger="intersect once" hx-get="/partial/components/sac" hx-select=".component_sac" hx-swap="this"></div>
    </div>

    <div class="ora-footer__cell ora-footer__cell--c2">
      <h4 class="ora-footer__label">Formas de pagamento</h4>
      {% render 'shared/components/footer/payments' %}
      <ul class="ora-footer__chips">
        <li class="ora-footer__stamp">
          <img src="{{ ctx.static_domain }}/production/static/img/struct/stamp_encryptssl.png" width="131" height="40" loading="lazy" alt="Site Seguro" />
        </li>
        <li class="ora-footer__stamp">
          <a href="http://www.google.com/safebrowsing/diagnostic?site={{ ctx.store.domain }}" target="_blank" rel="noopener noreferrer">
            <img src="{{ ctx.static_domain }}/production/static/img/struct/stamp_google_safe_browsing.png" width="100" height="40" loading="lazy" alt="Google Safe Browsing" />
          </a>
        </li>
        {% appsection footer_stamps %}
      </ul>
    </div>

    <div class="ora-footer__cell ora-footer__cell--c3">
      <h4 class="ora-footer__label">Plataforma</h4>
      <a class="ora-footer__platform" href="https://www.lojaintegrada.com.br?utm_source=lojas&utm_medium=rodape&utm_campaign={{ data.store.domain }}" target="_blank" title="Loja Integrada - Plataforma de loja virtual.">
        <img src="{% asset_url 'brand/logo-lojaintegrada-espresso.svg' %}" width="170" height="25" loading="lazy" alt="Loja Integrada" />
      </a>
    </div>
  </div>
</div>

{%- comment -%}ora-sync{%- endcomment -%}

{%- comment -%}ora-sync{%- endcomment -%}
