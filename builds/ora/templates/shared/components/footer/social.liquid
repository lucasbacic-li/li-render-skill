{%- assign social_youtube = props.social_networks.youtube | default: data.store.social_networks.youtube -%}
{%- assign social_twitter = props.social_networks.twitter | default: data.store.social_networks.twitter -%}
{%- assign social_tiktok = props.social_networks.tiktok | default: data.store.social_networks.tiktok -%}
{%- assign social_threads = props.social_networks.threads | default: data.store.social_networks.threads -%}
{%- assign social_pinterest = props.social_networks.pinterest | default: data.store.social_networks.pinterest -%}
{%- assign social_linkedin = props.social_networks.linkedin | default: data.store.social_networks.linkedin -%}
{%- assign social_instagram = props.social_networks.instagram | default: data.store.social_networks.instagram -%}
{%- assign social_facebook = props.social_networks.facebook | default: data.store.social_networks.facebook -%}
{%- assign social_blog = props.social_networks.blog | default: data.store.social_networks.blog -%}
{%- assign has_social_networks = social_youtube or social_twitter or social_tiktok or social_threads or social_pinterest or social_linkedin or social_instagram or social_facebook or social_blog -%}
{%- if has_social_networks -%}
  <div class="ora-footer__cell">
    <h4 class="ora-footer__label">Seguir</h4>
    <ul class="ora-footer__social">
      {%- if social_instagram -%}
        <li><a href="https://www.instagram.com/{{ social_instagram }}" target="_blank" rel="noopener" title="Instagram">
          <svg role="img" aria-label="Instagram"><use xlink:href="/static/img/fontawesome-brands.svg#instagram" href="/static/img/fontawesome-brands.svg#instagram"></use></svg>
        </a></li>
      {%- endif -%}
      {%- if social_tiktok -%}
        <li><a href="https://www.tiktok.com/{{ social_tiktok }}" target="_blank" rel="noopener" title="TikTok">
          <svg role="img" aria-label="TikTok"><use xlink:href="/static/img/fontawesome-brands.svg#tiktok" href="/static/img/fontawesome-brands.svg#tiktok"></use></svg>
        </a></li>
      {%- endif -%}
      {%- if social_youtube -%}
        <li><a href="https://www.youtube.com/{{ social_youtube }}" target="_blank" rel="noopener" title="YouTube">
          <svg role="img" aria-label="YouTube"><use xlink:href="/static/img/fontawesome-brands.svg#youtube" href="/static/img/fontawesome-brands.svg#youtube"></use></svg>
        </a></li>
      {%- endif -%}
      {%- if social_pinterest -%}
        <li><a href="https://pinterest.com/{{ social_pinterest }}" target="_blank" rel="noopener" title="Pinterest">
          <svg role="img" aria-label="Pinterest"><use xlink:href="/static/img/fontawesome-brands.svg#pinterest-p" href="/static/img/fontawesome-brands.svg#pinterest-p"></use></svg>
        </a></li>
      {%- endif -%}
      {%- if social_facebook -%}
        <li><a href="https://www.facebook.com/{{ social_facebook }}" target="_blank" rel="noopener" title="Facebook">
          <svg role="img" aria-label="Facebook"><use xlink:href="/static/img/fontawesome-brands.svg#square-facebook" href="/static/img/fontawesome-brands.svg#square-facebook"></use></svg>
        </a></li>
      {%- endif -%}
      {%- if social_threads -%}
        <li><a href="https://www.threads.net/{{ social_threads }}" target="_blank" rel="noopener" title="Threads">
          <svg role="img" aria-label="Threads"><use xlink:href="/static/img/fontawesome-brands.svg#threads" href="/static/img/fontawesome-brands.svg#threads"></use></svg>
        </a></li>
      {%- endif -%}
      {%- if social_twitter -%}
        <li><a href="https://x.com/{{ social_twitter }}" target="_blank" rel="noopener" title="X / Twitter">
          <svg role="img" aria-label="X / Twitter"><use xlink:href="/static/img/fontawesome-brands.svg#x-twitter" href="/static/img/fontawesome-brands.svg#x-twitter"></use></svg>
        </a></li>
      {%- endif -%}
      {%- if social_linkedin -%}
        <li><a href="https://www.linkedin.com/company/{{ social_linkedin }}" target="_blank" rel="noopener" title="LinkedIn">
          <svg role="img" aria-label="LinkedIn"><use xlink:href="/static/img/fontawesome-brands.svg#linkedin-in" href="/static/img/fontawesome-brands.svg#linkedin-in"></use></svg>
        </a></li>
      {%- endif -%}
      {%- if social_blog -%}
        <li><a href="{{ social_blog }}" target="_blank" rel="noopener" title="Blog">
          <svg role="img" aria-label="Blog"><use xlink:href="/static/img/fontawesome-brands.svg#blogger" href="/static/img/fontawesome-brands.svg#blogger"></use></svg>
        </a></li>
      {%- endif -%}
    </ul>
  </div>
{%- endif -%}
