{%- assign payment_brands_empty = '' | split: '' -%}
{%- assign payment_brands_props = payment_brands_empty -%}
{%- assign payment_brands_data = payment_brands_empty -%}
{%- if props.payment_brands[0] -%}
  {%- assign payment_brands_props = props.payment_brands -%}
{%- endif -%}
{%- if data.payment_conditions.brands[0] -%}
  {%- assign payment_brands_data = data.payment_conditions.brands -%}
{%- endif -%}
{%- assign payment_brands = payment_brands_props | concat: payment_brands_data | uniq | compact -%}
{%- if payment_brands != empty -%}
  <ul class="ora-footer__chips">
    {%- render 'shared/components/footer/payments-brands' for payment_brands as brand -%}
  </ul>
{%- endif -%}
