{%- comment -%}
  Componente: Search Autocomplete Result
  Descrição: Template reutilizável para exibir resultados de autocomplete
  
  Props:
  - autocomplete: Objeto com terms, categories e products
{%- endcomment -%}

{% if autocomplete.terms.size > 0 or autocomplete.products.size > 0 or autocomplete.categories.size > 0 %}
  <div class="flex flex-col gap-8">
    {%- comment -%} Termos de busca {%- endcomment -%}
    {% if autocomplete.terms.size > 0 %}
      <div class="flex flex-col gap-3 px-6">
        <span class="ora-label text-base-content block">
          {% if is_most_searched %}
            Termos mais buscados
          {% elsif is_suggestions %}
            Sugestões
          {% endif %}
        </span>
        <div class="flex flex-col">
          {% for term in autocomplete.terms limit: 5 %}
            <a
              href="/search?q={{ term | url_encode }}"
              class="flex items-center gap-2 py-1.5 hover:underline"
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <g opacity="0.5">
                <mask id="mask0_772_12424" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="16" height="16">
                <rect width="16" height="16" fill="#D9D9D9"/>
                </mask>
                <g mask="url(#mask0_772_12424)">
                <path d="M13.0667 14L8.86667 9.8C8.53333 10.0667 8.15 10.2778 7.71667 10.4333C7.28333 10.5889 6.82222 10.6667 6.33333 10.6667C5.12222 10.6667 4.09722 10.2472 3.25833 9.40833C2.41944 8.56944 2 7.54444 2 6.33333C2 5.12222 2.41944 4.09722 3.25833 3.25833C4.09722 2.41944 5.12222 2 6.33333 2C7.54444 2 8.56944 2.41944 9.40833 3.25833C10.2472 4.09722 10.6667 5.12222 10.6667 6.33333C10.6667 6.82222 10.5889 7.28333 10.4333 7.71667C10.2778 8.15 10.0667 8.53333 9.8 8.86667L14 13.0667L13.0667 14ZM6.33333 9.33333C7.16667 9.33333 7.875 9.04167 8.45833 8.45833C9.04167 7.875 9.33333 7.16667 9.33333 6.33333C9.33333 5.5 9.04167 4.79167 8.45833 4.20833C7.875 3.625 7.16667 3.33333 6.33333 3.33333C5.5 3.33333 4.79167 3.625 4.20833 4.20833C3.625 4.79167 3.33333 5.5 3.33333 6.33333C3.33333 7.16667 3.625 7.875 4.20833 8.45833C4.79167 9.04167 5.5 9.33333 6.33333 9.33333Z" fill="currentColor"/>
                </g>
                </g>
              </svg>
              {{- term -}}
            </a>
          {% endfor %}
        </div>
      </div>
    {% endif %}
    {%- comment -%} Categorias {%- endcomment -%}
    {% if autocomplete.categories.size > 0 %}
      <div class="flex flex-col gap-3 px-6">
        <span class="ora-label text-base-content block">
          Categorias
        </span>
        <div class="flex flex-col">
          {% for category in autocomplete.categories limit: 5 %}
            {% render 'shared/components/header/components/search/autocomplete/category', category: category %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
    {%- comment -%} Produtos {%- endcomment -%}
    {% if autocomplete.products.size > 0 %}
      <div class="flex flex-col">
        <span class="ora-label text-base-content block px-6 mb-4">
          {% if is_most_searched %}
            Produtos mais buscados
          {% elsif is_suggestions %}
            Produtos relacionados à busca
          {% endif %}
        </span>
        <carousel-embla
          data-slides-per-view="2.3"
          data-gap="1rem"
          data-loop="false"
          data-draggable="true"
          class="flex flex-col gap-4"
        >
          <div class="embla overflow-hidden px-6">
            <div class="embla__container flex gap-3">
              {%- assign img_height = '180' -%}
              {%- assign img_width = img_height | times: 2 -%}
              {% for product in autocomplete.products limit: 6 %}
                <div class="embla__slide min-w-0">
                  {% render 'shared/components/product-card/index', product: product, forloop: forloop, img_width: img_width, img_height: img_height %}
                </div>
              {% endfor %}
            </div>
          </div>
        </carousel-embla>
        {%- comment -%} Botão ver todos {%- endcomment -%}
        {% if is_suggestions %}
          <a href="/search?q={{ ctx.url.querystring.q | url_encode }}" class="btn btn-primary rounded-full self-start mx-6 mt-5">
            Ver todos os resultados
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="10" cy="10" r="10" fill="white"/>
              <path d="M7.5 5L12.5 10L7.5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"/>
            </svg>
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
{% else %}
  {% if is_suggestions and ctx.url.querystring.q %}
    {% assign empty_message = 'Sem resultados para "' | append: ctx.url.querystring.q | append: '"' %}
  {% endif %}
  {% render 'shared/components/header/components/search/autocomplete/empty', message: empty_message %}
{% endif %}



