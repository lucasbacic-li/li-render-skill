{%- comment -%}
  Componente: Category Match
  Descrição: Renderiza categoria com breadcrumb recursivo
  
  Props:
  - category: Objeto da categoria
  - category_name: Nome acumulado (para recursão)
{%- endcomment -%}
{% if category %}
  {% if category_name %}
    {% assign category_name = category_name | append: ' • ' | append: category.name %}
  {% else %}
    {% assign category_name = category.name %}
  {% endif %}
  
  {% if category.child %}
    {% render 'shared/components/header/components/search/autocomplete/category', category: category.child, category_name: category_name %}
  {% else %}
    <a
      href="{{ category.path }}"
      class="block py-1.5 hover:underline whitespace-nowrap text-ellipsis overflow-hidden text-left"
      dir="rtl"
      title="{{ category_name }}"
    >
      {{- category_name -}}
    </a>
  {% endif %}
{% endif %}

