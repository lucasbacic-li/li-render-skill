{%- comment -%}
  Componente: Search Drawer
  Descrição: Drawer lateral de busca com autocomplete
{%- endcomment -%}

<div class="drawer drawer-end">
  <input id="search-drawer-toggle" type="checkbox" class="drawer-toggle" autocomplete="off" data-role="drawer-toggle" aria-label="Abrir busca" />
  <div
    id="search-drawer-modal"
    class="drawer-side z-9999"
    role="dialog"
    aria-labelledby="search-drawer-title"
    aria-modal="true"
  >
    <label for="search-drawer-toggle" aria-label="Fechar busca" class="drawer-overlay"></label>
    <div class="w-full max-w-lg h-full overflow-y-auto scrollbar-thin bg-neutral text-base-content">
      {% render 'shared/components/header/components/search/component', variant: 'drawer' %}
    </div>
  </div>
</div>

