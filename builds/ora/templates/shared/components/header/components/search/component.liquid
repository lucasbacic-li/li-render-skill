{%- comment -%}
  Componente: Search Unified
  Parâmetros:
    - variant: 'dropdown' | 'drawer'
{%- endcomment -%}

{%- assign variant = variant | default: 'dropdown' -%}
{%- assign results_id = variant | append: '-search-results' -%}
{%- assign input_id = 'search-' | append: variant | append: '-input' -%}

<search-autocomplete variant="{{ variant }}" class="group">
  <div class="{% if variant == 'drawer' %}ora-drawer-head{% endif %}">
    <form role="search" action="/search" class="search-form flex flex-col gap-4 flex-1 {% if variant == 'drawer' %}px-6 py-4 justify-center{% endif %}" data-id="search-form">
      <label class="input input-md w-full">
        <input
          id="{{ input_id }}"
          name="q"
          type="search"
          placeholder="Buscar"
          value="{{ ctx.url.querystring.q }}"
          minlength="2"
          maxlength="255"
          spellcheck="false"
          autocorrect="off"
          autocomplete="off"
          required
          hx-get="/partial/search/suggestions?variant={{ variant }}"
          hx-trigger="input[target.value.length > 1] changed delay:500ms"
          hx-target="#{{ results_id }}"
          hx-sync="this:replace"
          data-id="search-input"
          {% if variant == 'dropdown' %}data-testid="li-header-search-input"{% endif %}
          {% comment %} class="peer [&::-webkit-search-cancel-button]:hidden [&::-webkit-search-decoration]:hidden" {% endcomment %}
        />
        {% comment %} <button
          data-id="search-clear"
          type="reset"
          class="btn btn-ghost btn-sm px-4 -mr-2.5 hidden peer-[:not(:placeholder-shown)]:inline-flex"
          {% if variant == 'dropdown' %}data-testid="li-header-search-clear"{% endif %}
        >
          Limpar
        </button> {% endcomment %}
        <button type="submit" class="btn btn-ghost btn-square -mr-6" aria-label="Pesquisar">
          <svg data-id="search-icon" class="fill-current size-3 shrink-0" role="img" aria-hidden="true">
            <use xlink:href="/static/img/fontawesome-solid.svg#magnifying-glass" href="/static/img/fontawesome-solid.svg#magnifying-glass"></use>
          </svg>
          <svg data-id="loading-icon" class="fill-current size-4 shrink-0 animate-spin hidden" role="img" aria-hidden="true">
            <use xlink:href="/static/img/fontawesome-solid.svg#spinner" href="/static/img/fontawesome-solid.svg#spinner"></use>
          </svg>
        </button>
      </label>
    </form>
    {%- if variant == 'drawer' -%}
      <label for="search-drawer-toggle" class="ora-drawer-head__close cursor-pointer shrink-0" aria-label="Fechar">
        <span class="sr-only">Fechar</span>
        <svg class="fill-current size-5 shrink-0" role="img" aria-hidden="true">
          <use xlink:href="/static/img/fontawesome-solid.svg#xmark" href="/static/img/fontawesome-solid.svg#xmark"></use>
        </svg>
      </label>
    {%- endif -%}
  </div>
  <div 
    id="{{ results_id }}"
    tabindex="-1"
    hx-get="/partial/search/most-searched?variant={{ variant }}"
    hx-target="#{{ results_id }}"
    hx-sync="[data-id='search-input']:abort"
    {% if variant == 'drawer' %}
      hx-trigger="change from:#search-drawer-toggle once"
    {% else %}
      hx-trigger="focus from:#{{ input_id }} once"
    {% endif %}
  ></div>
</search-autocomplete>

<script defer src="{% asset_url '/scripts/search-autocomplete.webc.js' %}"></script>

{%- comment -%}ora-sync{%- endcomment -%}
