{%- comment -%}
  Componente: Search Autocomplete (Drawer)
  Descrição: Resultados de autocomplete para drawer de busca
{%- endcomment -%}

{%- capture results_class -%}
  {%- if ctx.url.querystring.variant == 'dropdown' -%}
    absolute top-full right-0 mt-2 bg-neutral border border-base-200 rounded-md shadow-xl z-10 w-xl py-6 hidden group-has-focus:block group-focus-within:block focus-within:block focus:block
  {%- else -%}
    mt-1 mb-5
  {%- endif -%}
{%- endcapture -%}

<div class="overflow-y-auto scrollbar-thin {{ results_class }}">
  {% if data.autocomplete_result %}
    {% render 'shared/components/header/components/search/autocomplete/result', autocomplete: data.autocomplete_result, is_suggestions: true %}
  {% elsif data.mostsearched_result %}
    {% render 'shared/components/header/components/search/autocomplete/result', autocomplete: data.mostsearched_result, is_most_searched: true %}
  {% else %}
    {% render 'shared/components/header/components/search/autocomplete/empty' %}
  {% endif %}
</div>
