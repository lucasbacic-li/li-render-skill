
<div class="header_menu_mobile grow relative flex flex-col gap-6 px-6 py-3">
  {% if data.categories.size > 0 %}
    <div class="flex-1 border-b border-base-200">
      <span class="ora-label text-base-content block py-2">Categorias</span>
      <ul class="w-full pb-5 pt-1">
        {% for category in data.categories -%}
          {% render 'shared/components/header/components/navbar/category-item', 
            category: category, 
            prefix: 'cat', 
            level: 0,
            forloop: forloop
          %}
        {% endfor %}
      </ul>
    </div>
  {% endif %}
  {% if data.institutional_pages.size > 0 %}
    <div class="flex-1 border-b border-base-200">
      <span class="ora-label text-base-content block py-2">Links importantes</span>
      <ul class="w-full pb-5 pt-1">
        {% for page in data.institutional_pages %}
          <li>
            <a href="/pagina/{{ page.url }}" class="block text-base uppercase tracking-[var(--ora-tracking-caps)] py-2.5 break-words">{{ page.title }}</a>
          </li>
        {% endfor %}
      </ul>
    </div> 
  {% endif %}
  {% if data.suggestion_products.products.size > 0 %}
    <div class="flex-1">
      <span class="ora-label text-base-content block py-2">Produtos em destaque</span>
      <div class="w-full py-5 grid grid-cols-2 gap-6">
        {%- assign img_height = '170' -%}
        {%- assign img_width = img_height | times: 2 -%}
        {% for product in data.suggestion_products.products %}
          {% render 'shared/components/product-card/index', product: product, forloop: forloop, img_width: img_width, img_height: img_height %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

