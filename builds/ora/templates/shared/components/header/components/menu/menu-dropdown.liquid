{%- comment -%}
  Menu Dropdown - Componente reutilizável para categorias
  
  Props:
  - categories: Array de categorias a exibir
  - position: 'top' ou 'right' (default: 'top')
  - show_children: Boolean para mostrar filhos (default: true)
{%- endcomment -%}

{%- assign dropdown_position = position | default: 'top' -%}
{%- assign dropdown_show_children = show_children | default: true -%}

<ul tabindex="0" class="categories-container categories-container-{{ dropdown_position }}">
  {%- for category in categories -%}
    <li class="categories-container-item">
      <a href="{{ category.path }}" tabindex="0" class="categories-container-link" data-testid="li-menu-subitem">
        {{ category.name }}
        {%- if category.children.size > 0 and dropdown_show_children -%}
          <svg class="shrink-0 ml-1" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <mask id="mask_arrow_{{ forloop.index }}" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="20" height="20">
              <rect x="8.74228e-07" y="20" width="20" height="20" transform="rotate(-90 8.74228e-07 20)" fill="#D9D9D9"/>
            </mask>
            <g mask="url(#mask_arrow_{{ forloop.index }})">
              <path d="M13.4 10L7.4 16L6 14.6L10.6 10L6 5.4L7.4 4L13.4 10Z" fill="currentColor"/>
            </g>
          </svg>
        {%- endif -%}
      </a>
      {%- if category.children.size > 0 and dropdown_show_children -%}
        {% render 'shared/components/header/components/menu/menu-dropdown', categories: category.children, position: 'right', show_children: false %}
      {%- endif -%}
    </li>
  {%- endfor -%}
</ul>

