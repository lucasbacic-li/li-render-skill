{% comment %}
  Free Shipping Alert Component
  
  Exibe um alerta visual mostrando o progresso para atingir o frete grátis.
  
  Estados possíveis:
  - Frete grátis ativo (100%)
  - Frete grátis pendente com CEP (mostra quanto falta)
  - Sem frete grátis na região (0%)
  - Sem CEP selecionado (0%)
  
  Props esperadas:
  - data.cart_offers_conditions.free_shipping
  - data.cart.shipping.selected_address
  - layout_attributes.alerta_frete_gratis.fretegratis_ativo (boolean)
  - layout_attributes.alerta_frete_gratis.fretegratis_pendente (string)
  - layout_attributes.alerta_frete_gratis.fretegratis_cep (string)
  - layout_attributes.alerta_frete_gratis.fretegratis_indisponivel (string)
  - layout_attributes.alerta_frete_gratis.fretegratis_sucesso (string)
{% endcomment %}

{% if layout_attributes.alerta_frete_gratis.fretegratis_ativo %}
  {% if data.cart_offers_conditions.free_shipping %}
    {%- assign texto_pendente = layout_attributes.alerta_frete_gratis.fretegratis_pendente | default: "Com mais R$ {{ valor }} você ganha frete grátis!" -%}
    {%- assign texto_cep = layout_attributes.alerta_frete_gratis.fretegratis_cep | default: "Quer FRETE GRÁTIS? Digite o seu CEP e saiba quanto falta" -%}
    {%- assign texto_indisponivel = layout_attributes.alerta_frete_gratis.fretegratis_indisponivel | default: "Não há frete grátis para esta região" -%}
    {%- assign texto_sucesso = layout_attributes.alerta_frete_gratis.fretegratis_sucesso | default: "Você ganhou frete grátis" -%}
    {%- assign free_shipping = data.cart_offers_conditions.free_shipping -%}

    <div role="alert" class="mx-3 flex flex-col gap-2.5">
      {% if free_shipping.active %}
        {%- comment -%} Estado: Frete grátis conquistado {%- endcomment -%}
        <p class="text-xs font-medium text-success">{{ texto_sucesso }}</p>
        <progress class="progress progress-success w-full h-1" value="100" max="100"></progress>
      {% else %}
        {% if data.cart.shipping.selected_address %}
          {% if free_shipping.missing_value > 0 %}
            {%- comment -%} Estado: Frete grátis pendente (com CEP) {%- endcomment -%}
            {%- assign valor_formatado = free_shipping.missing_value | format_number: "C" -%}
            {%- assign texto_pendente_formatado = texto_pendente | replace: "R$", "" -%}
            {%- assign texto_pendente_formatado = texto_pendente_formatado | replace: "{{ valor }}", valor_formatado -%}
            {%- assign texto_pendente_formatado = texto_pendente_formatado | replace: "{{valor}}", valor_formatado -%}
            {%- assign current_value = free_shipping.target_value | minus: free_shipping.missing_value | replace: ",", "." -%}
            
            <p class="text-xs font-medium text-success">{{ texto_pendente_formatado }}</p>
            <progress class="progress progress-success w-full h-1" value="{{ current_value }}" max="{{ free_shipping.target_value }}"></progress>
          {% else %}
            {%- comment -%} Estado: Sem frete grátis disponível na região {%- endcomment -%}
            <p class="text-xs font-medium text-base-content">{{ texto_indisponivel }}</p>
            <progress class="progress progress-success w-full h-1" value="0" max="100"></progress>
          {% endif %}
        {% else %}
          {%- comment -%} Estado: Sem CEP informado {%- endcomment -%}
          <p class="text-xs font-medium text-base-content">{{ texto_cep }}</p>
          <progress class="progress progress-success w-full h-1" value="0" max="100"></progress>
        {% endif %}
      {% endif %}
    </div>
  {% endif %}
{% endif %}

