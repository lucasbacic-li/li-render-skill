{%- comment -%}
  Componente: Gift Progress
  Descrição: Mostra o progresso para ganhar um presente/brinde
  Props esperadas via data.cart_offers_conditions.gift:
    - total_cart_value: Valor atual do carrinho
    - amount_needed_for_gift: Valor necessário para ganhar o presente
    - applied_value_gift_offers: Valor já aplicado em ofertas de presente
{%- endcomment -%}

{%- assign gift_condition = data.cart_offers_conditions.gift -%}

{% if gift_condition and gift_condition.amount_needed_for_gift > 0 %}
  <div class="mx-6 px-4 py-3 border border-dashed border-primary rounded-box bg-gray-100 flex items-center gap-5">
    {%- comment -%} Ícone de presente {%- endcomment -%}
    <div class="shrink-0 mt-1">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <mask id="mask0_724_6124" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
          <rect width="24" height="24" fill="#D9D9D9"/>
        </mask>
        <g mask="url(#mask0_724_6124)">
          <path d="M4 22V11H2V5H7.2C7.11667 4.85 7.0625 4.69167 7.0375 4.525C7.0125 4.35833 7 4.18333 7 4C7 3.16667 7.29167 2.45833 7.875 1.875C8.45833 1.29167 9.16667 1 10 1C10.3833 1 10.7417 1.07083 11.075 1.2125C11.4083 1.35417 11.7167 1.55 12 1.8C12.2833 1.53333 12.5917 1.33333 12.925 1.2C13.2583 1.06667 13.6167 1 14 1C14.8333 1 15.5417 1.29167 16.125 1.875C16.7083 2.45833 17 3.16667 17 4C17 4.18333 16.9833 4.35417 16.95 4.5125C16.9167 4.67083 16.8667 4.83333 16.8 5H22V11H20V22H4ZM14 3C13.7167 3 13.4792 3.09583 13.2875 3.2875C13.0958 3.47917 13 3.71667 13 4C13 4.28333 13.0958 4.52083 13.2875 4.7125C13.4792 4.90417 13.7167 5 14 5C14.2833 5 14.5208 4.90417 14.7125 4.7125C14.9042 4.52083 15 4.28333 15 4C15 3.71667 14.9042 3.47917 14.7125 3.2875C14.5208 3.09583 14.2833 3 14 3ZM9 4C9 4.28333 9.09583 4.52083 9.2875 4.7125C9.47917 4.90417 9.71667 5 10 5C10.2833 5 10.5208 4.90417 10.7125 4.7125C10.9042 4.52083 11 4.28333 11 4C11 3.71667 10.9042 3.47917 10.7125 3.2875C10.5208 3.09583 10.2833 3 10 3C9.71667 3 9.47917 3.09583 9.2875 3.2875C9.09583 3.47917 9 3.71667 9 4ZM4 7V9H11V7H4ZM11 20V11H6V20H11ZM13 20H18V11H13V20ZM20 9V7H13V9H20Z" fill="currentColor"/>
        </g>
      </svg>

    </div>

    {%- comment -%} Conteúdo da mensagem {%- endcomment -%}
    <p class="text-sm text-base-content leading-5 flex-1">
      Presente especial para você! Falta pouco:
      adicione mais <strong class="font-medium">{{ gift_condition.amount_needed_for_gift | format_number: "C" }}</strong> para revelar essa surpresa.
    </p>
  </div>
{% endif %}

