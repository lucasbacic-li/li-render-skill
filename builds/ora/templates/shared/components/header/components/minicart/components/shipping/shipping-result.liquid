<div id="minicart-shipping-calculation" class="flex flex-col gap-6">
  {%- assign selected_address = data.cart.shipping.addresses | where: 'id', data.cart.shipping.selected_address | first -%} 

  <input-mask>
    <input
      id="minicart-zipcode" 
      name="zipcode" 
      value="{{ selected_address.cep }}" 
      type="text" 
      pattern="[0-9]{5}-[0-9]{3}"
      inputmode="numeric" 
      maxlength="9" 
      placeholder="00000-000" 
      class="input input-md w-full" 
      required
      data-mask="zipcode"
      data-testid="li-minicart-freight-input"
    />
  </input-mask>
  <button type="submit" class="btn btn-secondary w-full" data-testid="li-minicart-freight-submit">
    Calcular
  </button>
  {% if data.cart.shipping.selected_address %}
    <div class="border border-base-200 rounded-md px-4 py-2 text-sm text-base-content mt-3">
      {% if data.cart.shipping.deliveries.size > 0 %}
        <ul class="flex flex-col gap-2">
          {% for delivery in data.cart.shipping.deliveries %}
            <li class="flex items-center justify-between ">
              <div class="flex items-center gap-2">
                <span class="font-medium">{{ delivery.price | format_number: "C" }}</span>
                <span class="font-medium opacity-70">{{ delivery.name }}</span>
              </div>
              <span class="font-medium">{{ delivery.delivery_time }} dias úteis</span>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="font-medium text-base-content">Nenhuma opção de frete disponível para {{ selected_address.cep }}.</p>
      {% endif %}
    </div>
    <p class="text-xs text-base-content opacity-70 font-medium">* Este prazo de entrega está considerando a disponibilidade do produto + prazo de entrega.</p>
  {% endif %}
</div>


{%- comment -%}ora-sync{%- endcomment -%}
