      </button>
    </form>
{% else %}
  {%- comment -%} Estado: Sem cupom - Botão normal {%- endcomment -%}
  <button 
    type="button"
    hx-get="/partial/cart/coupon"
    hx-target="#coupon-portal"
    hx-swap="innerHTML"
    hx-indicator="find .htmx-indicator"
    class="btn btn-secondary gap-2 h-10 w-1/2 flex-1"
    data-testid="li-minicart-coupon-btn"
  >
    Cupom
  </button>
{% endif %}

