{%- if data.banners.size > 0 -%}
  {%- case props.position -%}
    {%- when 'full' -%}
      {% render 'shared/components/banner/components/full', banners: data.banners, props: props %}
    {%- when 'stripe' -%}
      {% render 'shared/components/banner/components/stripe', banners: data.banners, props: props %}
    {%- when 'showcase' -%}
      {% render 'shared/components/banner/components/showcase', banners: data.banners, props: props, splitted: props.splitted %}
    {%- when 'mini' -%}
      {% render 'shared/components/banner/components/mini', banners: data.banners, props: props %}
    {%- else -%}
      {% render 'shared/components/banner/components/showcase', banners: data.banners, props: props %}
  {%- endcase -%}
{%- endif -%}

