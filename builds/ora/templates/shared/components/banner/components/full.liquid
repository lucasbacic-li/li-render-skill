<div class="container py-4 content-auto-[500px]">
  <carousel-embla 
    data-slides-per-view="1"
    data-loop="true"
    data-autoplay="true"
    data-autoplay-delay="10000"
    data-show-progress="true"
    data-auto-height="true"
    class="relative mx-auto"
  >
    <div class="embla rounded-box overflow-hidden">
      <div class="embla__container flex">
        {% for banner in banners %}
          <div class="embla__slide flex-[0_0_100%] min-w-0">
            {% if banner.url and banner.url contains '/' %}
              <a href="{{ banner.url }}" target="{{ banner.target | default:'_self' }}" class="block w-full">
            {% endif %}
              <picture class="block mx-auto">
                {% assign image_mobile = banner.image_mobile %}
                {% if image_mobile %}
                  <source
                    media="(max-width:767px)"
                    srcset="{{ ctx.static_domain }}/768x1000{{ image_mobile }} 768w,
                            {{ ctx.static_domain }}/540x1000{{ image_mobile }} 540w,
                            {{ ctx.static_domain }}/412x1000{{ image_mobile }} 412w,
                            {{ ctx.static_domain }}/360x1000{{ image_mobile }} 360w,
                            {{ ctx.static_domain }}/320x1000{{ image_mobile }} 320w,
                            {{ ctx.static_domain }}/154x1000{{ image_mobile }} 154w"
                    sizes="100vw"
                    width="{{ banner.width_mobile | default: 767 }}"
                    height="{{ banner.height_mobile | default: 767 }}"
                  />
                {% endif %}
                <img
                  src="{{ ctx.static_domain }}/1920x1000{{ banner.image }}"
                  srcset="{{ ctx.static_domain }}/154x1000{{ banner.image }} 154w,
                          {{ ctx.static_domain }}/320x1000{{ banner.image }} 320w,
                          {{ ctx.static_domain }}/360x1000{{ banner.image }} 360w,
                          {{ ctx.static_domain }}/412x1000{{ banner.image }} 412w,
                          {{ ctx.static_domain }}/540x1000{{ banner.image }} 540w,
                          {{ ctx.static_domain }}/768x1000{{ banner.image }} 768w,
                          {{ ctx.static_domain }}/1280x1000{{ banner.image }} 1280w,
                          {{ ctx.static_domain }}/1440x1000{{ banner.image }} 1440w,
                          {{ ctx.static_domain }}/1920x1000{{ banner.image }} 1920w"
                  sizes="(min-width: 80rem) 80rem, 100vw"
                  alt="{{ banner.alt }}"
                  width="{{ banner.width | default: 1920 }}"
                  height="{% if forloop.first %}{{ banner.height | default: 700 }}{% else %}10{% endif %}"
                  class="block h-auto object-contain w-full mx-auto"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  {% if forloop.first %}fetchpriority="high"{% endif %}
                />
              </picture>
              {% if banner.title %}
                <span class="absolute inset-0 flex flex-col gap-6 items-start justify-end pb-6 px-6">
                  <h2 class="text-[var(--ora-section-head)] font-medium text-base-100 mix-blend-difference">{{ banner.title }}</h2>
                  {% comment %} <button class="btn btn-primary btn-lg">
                    Label
                    <svg class="text-primary" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M0 12C0 5.37258 5.37258 0 12 0C18.6274 0 24 5.37258 24 12C24 18.6274 18.6274 24 12 24C5.37258 24 0 18.6274 0 12Z" fill="#F5F6F8"/>
                      <mask id="mask0_457_1909" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
                        <rect width="24" height="24" fill="#D9D9D9"/>
                      </mask>
                      <g mask="url(#mask0_457_1909)">
                        <path d="M13.625 17L12.4875 15.7917L15.3719 12.8333H5.5V11.1667H15.3719L12.4875 8.20833L13.625 7L18.5 12L13.625 17Z" fill="currentColor"/>
                      </g>
                    </svg>
                  </button> {% endcomment %}
                </span>
              {% endif %}
            {% if banner.url and banner.url contains '/' %}
              </a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  
    {% if banners.size > 1 %}
      <div class="flex justify-center gap-2 absolute top-1.5 left-6 right-6">
        {% for banner in banners %}
          <button
            data-carousel-dot
            class="w-full py-4"
            aria-label="Ir para banner {{ forloop.index }}"
          >
            <span class="block relative w-full h-1 rounded-sm bg-neutral shadow transition-all"></span>
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </carousel-embla>
</div>

