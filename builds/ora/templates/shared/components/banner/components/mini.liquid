<div class="container mb-4 px-4 overflow-hidden content-auto-[300px]">
  <carousel-embla 
    data-slides-per-view="2"
    data-slides-per-view-md="3"
    data-gap="0.5rem"
    data-loop="false"
    data-draggable="true"
    class="relative"
  >
    <div class="embla overflow-hidden">
      <div class="embla__container flex gap-2">
        {% for banner in banners %}
          <div class="embla__slide flex-[0_0_calc(50%-0.25rem)] min-w-0">
            {% if banner.url and banner.url contains '/' %}
              <a href="{{ banner.url }}" target="{{ banner.target | default:'_self' }}" class="block w-full h-full">
            {% endif %}
              <picture class="block w-full h-full rounded-box overflow-hidden relative">
                {% assign image_mobile = banner.image_mobile %}
                {% if image_mobile %}
                  <source
                    media="(max-width:767px)"
                    srcset="{{ ctx.static_domain }}/412x600{{ image_mobile }} 412w,
                            {{ ctx.static_domain }}/360x600{{ image_mobile }} 360w,
                            {{ ctx.static_domain }}/320x600{{ image_mobile }} 320w"
                    sizes="(max-width:767px) 50vw"
                    width="{{ banner.width_mobile | default: 400 }}"
                    height="{{ banner.height_mobile | default: 600 }}"
                  />
                {% endif %}
                <img
                  src="{{ ctx.static_domain }}/600x600{{ banner.image }}"
                  srcset="{{ ctx.static_domain }}/320x600{{ banner.image }} 320w,
                          {{ ctx.static_domain }}/412x600{{ banner.image }} 412w,
                          {{ ctx.static_domain }}/600x600{{ banner.image }} 600w,
                          {{ ctx.static_domain }}/800x600{{ banner.image }} 800w"
                  sizes="(max-width:767px) 50vw, 400px"
                  alt="{{ banner.alt }}"
                  width="{{ banner.width | default: 600 }}"
                  height="{{ banner.height | default: 600 }}"
                  class="block w-full h-full object-cover"
                  loading="lazy"
                />
                {% if banner.title %}
                  <span class="absolute inset-0 flex flex-col gap-3 items-start justify-end pb-4 px-4">
                    <h3 class="text-[var(--ora-section-head)] font-medium text-base-100 mix-blend-difference">{{ banner.title }}</h3>
                  </span>
                {% endif %}
              </picture>
            {% if banner.url and banner.url contains '/' %}
              </a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </carousel-embla>
</div>

