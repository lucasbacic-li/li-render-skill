{% assign payment_discount = data.payment_conditions.discount %}
{% assign payment_installment = data.payment_conditions.installment %}
{% assign free_freight_conditions = data.freight_conditions %}

{% assign slide_keys = "" %}
{% if payment_discount.percent > 0 %}{% assign slide_keys = slide_keys | append: "discount," %}{% endif %}
{% if payment_installment.installment_number > 0 %}{% assign slide_keys = slide_keys | append: "installment," %}{% endif %}
{% if free_freight_conditions.size > 0 %}{% assign slide_keys = slide_keys | append: "freight," %}{% endif %}
{% assign slide_keys = slide_keys | split: "," | shuffle %}

{% if slide_keys.size > 0 %}
  <carousel-embla 
    data-slides-per-view="1"
    data-loop="true"
    data-autoplay="true"
    data-autoplay-delay="7000"
    class="relative mx-auto"
  >
    <div class="embla overflow-hidden bg-primary text-primary-content text-center font-medium text-sm tracking-[var(--ora-tracking-caps)] uppercase break-words">
      <div class="embla__container flex select-none">
        {% assign stripe_class = 'embla__slide min-w-0 flex-[0_0_100%] flex items-center justify-center w-full m-0 px-3 py-1.5' %}
        {% for key in slide_keys %}
          {% case key %}
          {% when "discount" %}
            <p class="{{ stripe_class }}">
              {{ payment_discount.percent }}% de desconto via
              {% if payment_discount.payment_code contains "-external" %}
                Cartão de crédito
              {% elsif payment_discount.payment_code contains "-boleto" %}
                Boleto Bancário
              {% elsif payment_discount.payment_code contains "-pix" %}
                Pix
              {% else %}
                {{ payment_discount.payment_type }}
              {% endif %}
            </p>
          {% when "installment" %}
            <p class="{{ stripe_class }}">
              Pague em até {{ payment_installment.installment_number }}x {% if payment_installment.no_rate %}sem juros {% endif %}no cartão
            </p>
          {% when "freight" %}
            {% assign free_freight_min_value = free_freight_conditions[0].min_value %}
            {% assign free_freight_name = free_freight_conditions[0].name %}
            {% assign free_freight_unique = free_freight_conditions.size == 1 %}
            <p class="{{ stripe_class }}">
              Frete Grátis a partir de {{ free_freight_min_value | format_number: "C" }}
              {%- if free_freight_name != "Todas" -%}
                {% if free_freight_unique %} para {{ free_freight_name }}{% else %}. Consulte condições do seu CEP{% endif %}
              {%- endif -%}
            </p>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </carousel-embla>
{% endif %}
