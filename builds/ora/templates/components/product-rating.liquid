{% if layout_attributes.product_review.active %}
  {% if product.rating.total > 0 or layout_attributes.product_review.display_no_ratings_message %}
    <div class="flex flex-wrap">
      <a href="{{ product.url }}#reviews">
        {% render 'partials/stars', rating: product.rating.average, size: size %}
        <span class="text-xs text-base-content/70 align-text-top leading-6">({{ product.rating.total | default: 0 }})</span>
      </a>
    </div>
  {% endif %}
{% endif %}
