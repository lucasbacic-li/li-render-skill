{% if data.search_result.products.size > 0 %}
  {%- if props.mobile or is_mobile -%}
    {% assign hidden_mobile_class = 'flex md:hidden' %}
  {%- else -%}
    {% assign hidden_mobile_class = 'hidden md:flex' %}
  {%- endif -%}

  {% assign products_sort = data.search_result.sort %}
  {%- if products_sort.size > 0 -%}
    <label class="{{ hidden_mobile_class }} gap-6 md:gap-2 items-center border-b border-base-200 md:border-b-0 pb-6 md:pb-0">
      <span class="md:inline text-sm text-nowrap">
        Ordernar por
      </span>
      <select
        name="sort"
        class="select select-ghost w-full md:w-40 bg-neutral border border-base-200 rounded-full"
        data-testid="li-shelf-sort"
        aria-label="Ordenar produtos por"
        onchange="clearTimeout(window.liSearchSortTimeout);window.liSearchSortTimeout=setTimeout(()=>location.href=this.value,500)"
      >
        {% for option in products_sort %}
          {% assign option_link = option.link | split: '?' | last %}
          {%- capture option_name -%}
            {%- case option.key -%}
              {%- when 'relevance' -%}
                Relevância
              {%- when 'a-z' -%}
                Nome A-Z
              {%- when 'z-a' -%}
                Nome Z-A
              {%- when 'cheapest' -%}
                Menor preço
              {%- when 'most_expensive' -%}
                Maior preço
              {%- when 'discount' -%}
                Maior desconto
              {%- when 'newest' -%}
                Mais recentes
              {%- when 'best_selling' -%}
                Mais vendidos
              {%- when 'most_reviews' -%}
                Mais avaliados
              {%- when 'random' -%}
                Aleatório
              {%- else -%}
                {{ option.key }}
            {%- endcase -%}
          {%- endcapture -%}
          <option
            value="{{ ctx.url.path }}?{{ option_link }}"
            data-id="{{ option.key }}"
            {% if option.selected %}selected{% endif %}
          >
            {{- option_name | default: option.key -}}
          </option>
        {% endfor %}
      </select>
    </label>
  {%- endif -%}
{% endif %}
