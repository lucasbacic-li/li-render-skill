{%- assign filter_ref_id = 'filters-option-' | append: filter_ref -%}
{%- assign selected_options = filter_options | where: 'selected', true -%}

<div class="py-5 first:pt-0 border-b border-base-200 last:border-b-0 flex flex-col gap-5" id="{{ filter_ref_id }}">
  <div class="flex items-center justify-between">
    <h2 class="font-medium text-lg leading-7 break-words" data-testid="li-filter-name">
      {{ filter_name }}
    </h2>
    {% if selected_options.size > 0 and filter_remove %}
      <a
        href="{{ ctx.url.path }}?{{ filter_remove }}"
        class="block text-xs text-base-content underline hover:text-base-content"
      >
        Limpar
      </a>
    {% endif %}
  </div>
  <expandable-content
    class="block overflow-hidden max-h-48"
    {% if selected_options.size > 0 %}open{% endif %}
  >
    <div
      class="{% unless filter_price_range %}flex flex-col gap-2.5{% endunless %}"
      id="{{ filter_ref_id }}-section"
    >
      {% if filter_price_range %}
        {% render 'pages/search/components/filters/filters-price', filter_price_range: filter_price_range %}
      {% else %}
        {% for option in filter_options %}
          {%- assign option_link = option.link | split: '?' | last -%}
          {%- comment -%} Estrutura padrão para outros filtros {%- endcomment -%}
          <label
            for="{{ filter_ref_id }}-{{ forloop.index }}"
            class="flex items-center gap-2 w-full {% if option.count == 0 %}opacity-50 pointer-events-none{% else %}cursor-pointer hover:font-semibold{% endif %}"
            data-testid="li-filter-option"
          >
            <input
              id="{{ filter_ref_id }}-{{ forloop.index }}"
              name="{{ filter_ref_id }}-{{ forloop.index }}"
              value="{{ option_link }}"
              type="checkbox"
              class="peer checkbox checkbox-sm checkbox-primary accent-primary rounded-selector border-base-300 checked:border-primary flex items-center justify-center border-2"
              {% if option.selected %}checked{% endif %}
              {% if option.count == 0 %}disabled{% endif %}
              hx-get="{{ ctx.url.path }}?{{ option_link }}"
              hx-trigger="change delay:500ms"
              hx-target="#search-result"
              hx-select="#search-result"
              hx-swap="outerHTML show:top"
              hx-push-url="true"
              hx-disabled-elt="button, input"
              hx-sync="this:abort"
            />
            <span class="flex-1 flex gap-3 items-center justify-between text-sm text-base-content peer-checked:font-medium">
              {% render 'pages/search/components/filters/filters-value', filter_name: filter_name, option: option %}
              <span>{{ option.count }}</span>
            </span>
          </label>
        {% endfor %}
      {% endif %}
    </div>
  </expandable-content>
</div>
