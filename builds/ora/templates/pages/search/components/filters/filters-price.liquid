{% comment %} #TODO: NOT IMPLEMENTED {% endcomment %}
{%- capture slide_thumb_css -%}
  absolute pointer-events-none appearance-none z-20 h-2 w-full opacity-0 cursor-pointer
  [&::-webkit-slider-thumb]:pointer-events-all [&::-moz-range-thumb]:pointer-events-all [&::-ms-thumb]:pointer-events-all
  [&::-webkit-slider-thumb]:pointer-events-auto [&::-moz-range-thumb]:pointer-events-auto [&::-ms-thumb]:pointer-events-auto
  [&::-webkit-slider-thumb]:appearance-none [&::-moz-range-thumb]:appearance-none [&::-ms-thumb]:appearance-none
  [&::-webkit-slider-thumb]:w-6 [&::-moz-range-thumb]:w-6 [&::-ms-thumb]:w-6
  [&::-webkit-slider-thumb]:h-6 [&::-moz-range-thumb]:h-6 [&::-ms-thumb]:h-6
{%- endcapture -%}
{% assign filter_price_min = filter_price_range.min | default: 0 | floor %}
{% assign filter_price_max = filter_price_range.max | default: 10000 | ceil %}

<price-range-slider 
  data-min="{{ filter_price_min }}" 
  data-max="{{ filter_price_max }}" 
  class="relative mt-5"
>
  <div>
    <input type="range" step="1" class="{{ slide_thumb_css }}" data-type="min">
    <input type="range" step="1" class="{{ slide_thumb_css }}" data-type="max">
    <div class="relative z-10 h-2">
      <div class="absolute z-10 left-0 right-0 bottom-0 top-0 rounded-selector bg-base-content/10"></div>
      <div class="absolute z-20 top-0 bottom-0 rounded-selector bg-primary range-track"></div>
      <div class="absolute z-30 w-6 h-6 top-0 left-0 bg-primary rounded-full -mt-2 min-thumb"></div>
      <div class="absolute z-30 w-6 h-6 top-0 right-0 bg-primary rounded-full -mt-2 max-thumb"></div>
    </div>
  </div>
  <div class="flex items-center justify-between pt-5 space-x-4 text-sm text-base-content/70">
    <div class="flex-1">
      <input type="number" maxlength="5" data-type="min-input"
        step="1" inputmode="numeric" pattern="\d*"
        class="w-full input">
    </div>
    <div class="flex-1">
      <input type="number" maxlength="5" data-type="max-input"
        step="1" inputmode="numeric" pattern="\d*"
        class="w-full input">
    </div>
  </div>
  <div class="filter-changed-indicator hidden">FILTRO ALTERADO</div>
</price-range-slider>

<script defer src="{% asset_url '/scripts/price-range-slider.webc.js' %}"></script>
