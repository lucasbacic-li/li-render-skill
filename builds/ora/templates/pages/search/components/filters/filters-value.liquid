<span class="min-w-0 break-words">
  {% comment %} --- Filtro: Avaliação de produtos --- {% endcomment %}
  {%- if filter_name == 'Avaliação' and option.value contains '-' -%}
    {%- assign rating_star = option.value | split: '-' | first | plus: 0.0 -%}
    {%- capture rating_filter -%}
      {%- if rating_star >= 4.5 -%}
        5
      {%- elsif rating_star >= 3.5 -%}
        4
      {%- elsif rating_star >= 2.5 -%}
        3
      {%- elsif rating_star >= 1.5 -%}
        2
      {%- elsif rating_star >= 0 -%}
        1
      {%- endif -%}
    {%- endcapture -%}
    {% render 'partials/stars', rating: rating_filter, size: 'sm' %}
  {% comment %} --- Filtro: Preços --- {% endcomment %}
  {%- elsif filter_name == 'Preço' and option.value contains '-' -%}
    {%- assign precos = option.value | split: '-' -%}
    {%- assign preco_first = precos | first -%}
    {%- assign preco_last = precos | last -%}
    {%- if preco_last == '*' -%}
      Acima de <span class="text-nowrap">{{ preco_first | format_number: "C" }}</span>
    {%- else -%}
      <span class="text-nowrap">{{ preco_first | format_number: "C" }}</span> até <span class="text-nowrap">{{ preco_last | format_number: "C" }}</span>
    {%- endif -%}
  {% comment %} --- Filtro: Cores --- {% endcomment %}
  {%- elsif filter_name == 'Cor' and option.value contains '|#' -%}
    {%- assign color = option.value | split: '|' -%}
    <div class="shrink-0 {% if size == 'small' %}size-5{% else %}size-10 p-1{% endif %} rounded-lg border border-base-200" title="{{ color | first }}">
      <span
        class="inline-block size-full rounded-sm" 
        style="background-color: {{ color | last }};"
      ></span>
      <span class="sr-only">{{ color | first }}</span>
    </div>
  {% comment %} --- Filtro: Todos --- {% endcomment %}
  {%- else -%}
    {{ option.value }}
  {%- endif -%}
</span>
