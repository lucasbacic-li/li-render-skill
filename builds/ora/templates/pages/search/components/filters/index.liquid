{%- assign filters = data.search_result.filters -%}
{%- if filters.size > 0 -%}
  {%- assign total_selected_filters = 0 -%}
  {%- for filter in filters -%}
    {%- assign selected_in_filter = filter.values | where: 'selected', true -%}
    {%- assign total_selected_filters = total_selected_filters | plus: selected_in_filter.size -%}
  {%- endfor -%}
  <aside class="w-full flex flex-wrap items-center shrink-0 gap-5 md:max-w-75">
    <form id="category-filters" class="w-full" role="search">
      <div class="drawer drawer-end md:drawer-open md:block">
        <input id="search-filters-drawer-toggle" type="checkbox" class="drawer-toggle" data-role="drawer-toggle" hx-preserve autocomplete="off" />
        <div class="drawer-content">
        <label for="search-filters-drawer-toggle" class="btn drawer-button md:hidden font-medium w-full justify-between">
          Filtrar e ordenar
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <mask id="mask0_549_21966" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
            <rect width="24" height="24" fill="#D9D9D9"/>
            </mask>
            <g mask="url(#mask0_549_21966)">
              <path d="M11 21V15H13V17H21V19H13V21H11ZM3 19V17H9V19H3ZM7 15V13H3V11H7V9H9V15H7ZM11 13V11H21V13H11ZM15 9V3H17V5H21V7H17V9H15ZM3 7V5H13V7H3Z" fill="currentColor"/>
            </g>
          </svg>
        </label>
        
        {%- comment -%} Badges de filtros selecionados {%- endcomment -%}
        {%- if total_selected_filters > 0 -%}
          <div class="flex flex-wrap gap-2 mt-4">
            {%- for filter in filters -%}
              {%- assign selected_options = filter.values | where: 'selected', true -%}
              {%- for option in selected_options -%}
                {%- assign remove_link = option.link | split: '?' | last -%}
                {%- assign is_color_filter = false -%}
                {%- if filter.key == 'Cor' and option.value contains '|#' -%}
                  {%- assign is_color_filter = true -%}
                  {%- assign color = option.value | split: '|' -%}
                {%- endif -%}
                
                <a 
                  href="{{ ctx.url.path }}?{{ remove_link }}"
                  class="inline-flex items-center gap-1 px-4 py-2.5 min-h-10 bg-base-200 text-base-content min-w-0 break-words rounded-full text-sm font-medium hover:bg-base-300 transition-colors"
                  hx-get="{{ ctx.url.path }}?{{ remove_link }}"
                  hx-trigger="click"
                  hx-target="#search-result"
                  hx-select="#search-result"
                  hx-swap="outerHTML show:top"
                  hx-push-url="true"
                  hx-sync="this:abort"
                >
                  {% render 'pages/search/components/filters/filters-value', filter_name: filter.key, option: option, size: "small" %}
                  <svg class="ml-1" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <mask id="mask0_501_29444" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="20" height="20">
                      <rect width="20" height="20" fill="#D9D9D9"/>
                    </mask>
                    <g mask="url(#mask0_501_29444)">
                      <path d="M5.33366 15.8334L4.16699 14.6667L8.83366 10L4.16699 5.33335L5.33366 4.16669L10.0003 8.83335L14.667 4.16669L15.8337 5.33335L11.167 10L15.8337 14.6667L14.667 15.8334L10.0003 11.1667L5.33366 15.8334Z" fill="currentColor"/>
                    </g>
                  </svg>
                </a>
              {%- endfor -%}
            {%- endfor -%}
            
            {%- comment -%} Botão Limpar {%- endcomment -%}
            {%- assign remove_link = '' -%}
            {% if ctx.url.querystring.q %}
              {%- assign remove_link = 'q=' | append: ctx.url.querystring.q -%}
            {%- endif -%}
            <a 
              href="{{ ctx.url.path }}?{{ remove_link }}"
              class="inline-flex items-center px-3 py-2 text-sm font-medium text-primary hover:text-primary/80 transition-colors"
              hx-get="{{ ctx.url.path }}?{{ remove_link }}"
              hx-trigger="click"
              hx-target="#search-result"
              hx-select="#search-result"
              hx-swap="outerHTML show:top"
              hx-push-url="true"
              hx-sync="this:abort"
            >
              Limpar
            </a>
          </div>
        {%- endif -%}
      </div>
      <div
        id="category-filters-modal"
        class="drawer-side md:h-auto"
        role="dialog"
        aria-labelledby="filter-over-title"
        aria-modal="true"
      >
        <label for="search-filters-drawer-toggle" aria-label="Fechar filtros" class="drawer-overlay"></label>
        <div class="flex min-h-screen md:min-h-auto w-5/6 md:w-full max-w-md flex-col bg-neutral md:bg-transparent">
          <div class="flex items-center justify-between px-6 py-5 md:hidden border-b border-base-200">
            <p class="ora-drawer-title" id="filter-over-title">Filtros</p>
            <label for="search-filters-drawer-toggle" class="btn btn-ghost h-6 p-0">
              <span class="sr-only">Fechar</span>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <mask id="mask0_501_29402" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
                <rect width="24" height="24" fill="#D9D9D9"/>
                </mask>
                <g mask="url(#mask0_501_29402)">
                <path d="M6.4 19L5 17.6L10.6 12L5 6.4L6.4 5L12 10.6L17.6 5L19 6.4L13.4 12L19 17.6L17.6 19L12 13.4L6.4 19Z" fill="currentColor"/>
                </g>
              </svg>
            </label>
          </div>
          <div class="p-6 pb-0 md:hidden">
            {% render 'pages/search/sort', is_mobile: true %}
          </div>
          <div class="flex-1 overflow-y-auto scrollbar-thin px-6 md:px-0">
            {% for filter in filters %}
              {% if filter.values.size > 0 %}
                {%- assign filter_ref = filter.key | slugify -%}
                {% render 'pages/search/components/filters/filters-options', filter_ref: filter_ref, filter_name: filter.key, filter_options: filter.values, filter_remove: filter.remove_filter %}
              {% endif %}
            {% endfor %}
          </div>
          
          {% comment %} <div class="sticky bottom-0 bg-neutral border-t border-base-200 px-6 py-5 flex flex-col gap-3">
            <button 
              type="button" 
              class="btn btn-md btn-primary"
              data-action="apply-filters"
            >
              Aplicar filtros
              <span class="hidden" data-filter-counter></span>
            </button>
            <button 
              type="button" 
              class="btn btn-outline hidden"
              data-action="clear-filters"
            >
              Limpar
            </button>
          </div> {% endcomment %}
          {% comment %} <div class="pointer-events-none sticky bottom-0 flex h-10 bg-base-100 mask-t-from-0%"></div> {% endcomment %}
        </div>
      </div>
    </form>
  </aside>
  <script defer src="{% asset_url '/scripts/expandable-content.webc.js' %}"></script>
{%- endif -%}
