{%- assign _valid_shelves = 'highlights,newest,bestselling' | split: ',' -%}
{%- assign _shelf_flag = layout_attributes.render.shelf[props.shelf_id] -%}
{%- assign _render_shelf = _valid_shelves contains props.shelf_id and _shelf_flag != false -%}

{%- if _render_shelf and data.shelf_result.products.size > 0 -%}
  {%- assign shelf_products = data.shelf_result.products -%}
  {% render 'shared/components/shelf/index', 
    products: shelf_products,
    title: props.title,
    shelf_type: 'carousel'
  %}
{%- endif -%}
