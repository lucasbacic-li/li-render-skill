{% assign selected_sku = data.product.selected_sku %}
<div class="ora-pdp-rail md:col-start-2 p-5 md:p-14 md:border-l md:border-b border-[color:var(--ora-line-2)]">
  <sticky-container class="block md:top-[calc(var(--ora-headbar-h)+24px)]">

    {%- comment -%} Breadcrumb — vive no topo da coluna de decisão (ref. Paper) {%- endcomment -%}
    {%- assign categories_tree = data.product.main_category -%}
    <nav aria-label="breadcrumb" role="navigation" class="breadcrumbs flex items-center pb-4 text-sm text-base-content border-b border-[color:var(--ora-line-2)] overflow-x-auto scrollbar-none">
      <ul class="flex items-center">
        <li><a title="Ir para a página inicial" href="/" class="block hover:text-primary">Início</a></li>
        {% if categories_tree %}
          {% render 'shared/components/breadcrumb/item', category: categories_tree %}
        {% endif %}
        <li aria-current="page" class="opacity-60">{{ data.product.name }}</li>
      </ul>
    </nav>

    {%- comment -%} Título + favoritar {%- endcomment -%}
    <div class="flex flex-col gap-1 pt-6 pb-4 border-b border-[color:var(--ora-line-2)]" id="product-info" hx-swap-oob="true">
      {% if data.product.brand.name %}
        {% assign brand = data.product.brand %}
        <a href="/marca{{ brand.path }}" class="block text-xs uppercase tracking-[var(--ora-tracking-caps)] text-base-content font-medium hover:underline">{{ brand.name }}</a>
      {% endif %}
      <div class="flex items-start justify-between gap-8">
        <h1 class="flex-1 break-words text-base-content">
          {{ data.product.name }}
        </h1>
        {% render 'pages/product/components/favorites/index', product_id: data.product.id %}
      </div>
      {% appsection after_product_title %}
    </div>

    <div id="product-summary">
      {% if selected_sku %}
        {% if selected_sku.available %}
          {% unless selected_sku.price.upon_request %}
            {% render 'pages/product/components/pricing/index', price: selected_sku.price %}
          {% endunless %}
        {% endif %}
      {% else %}
        {% if data.product.available %}
          {% unless data.product.price.upon_request %}
            {% render 'pages/product/components/pricing/index', price: data.product.price %}
          {% endunless %}
        {% endif %}
      {% endif %}
      <div class="relative flex flex-col gap-5 md:gap-8 mt-5">
        {% render 'pages/product/components/product-variations/index' %}
        <span id="prod-variations-selector-spinner" class="hidden [&.htmx-request]:flex absolute inset-0 size-full z-10 bg-base-content/10"></span>
      </div>
    </div>

    {%- comment -%} "Sobre o produto" — descrição com hierarquia de header de bottom-sheet {%- endcomment -%}
    <div class="ora-pdp-accordion mt-6">
      {% render 'pages/product/components/description/index', rail: true %}
    </div>

    <div class="pointer-events-none sticky bottom-0 flex h-10 bg-neutral mask-t-from-0%"></div>
  </sticky-container>

  {% comment %} Floating Buy Button (mobile) {% endcomment %}
  {% render 'pages/product/components/floating-buy-button/index' %}
  <script defer src="{% asset_url '/scripts/sticky-container.webc.js' %}"></script>
  <div id="upon-request-portal"></div>
  <div id="notify-me-portal"></div>
</div>
