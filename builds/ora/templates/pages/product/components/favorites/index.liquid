<product-favorites class="shrink-0" data-product-id="{{ product_id }}" data-href="/conta/favorito/{{ product_id }}/adicionar">
  <a 
    class="block p-1.5 opacity-20 transition-all hover:opacity-50 hover:scale-110"
    href="/conta/favorito/{{ product_id }}/adicionar"
    title="Adicionar aos favoritos"
  >
    <svg class="fill-current size-5" role="img" aria-hidden="true">
      <use xlink:href="/static/img/fontawesome-solid.svg#heart" href="/static/img/fontawesome-solid.svg#heart"></use>
    </svg>
    <span class="loading loading-spinner loading-sm hidden"></span>
  </a>
</product-favorites>
<script defer src="{% asset_url '/scripts/product-favorites.webc.js' %}"></script>
