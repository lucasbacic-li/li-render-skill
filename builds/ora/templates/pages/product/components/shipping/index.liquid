<form
  id="prod-shipping-form"
  method="get"
  {% if selected_sku %}
    hx-get="/store/cart/freight/{{ selected_sku.id }}"
    hx-target="#prod-shipping-result"
    hx-select="#prod-shipping-result"
    hx-indicator="#prod-shipping-spinner"
    hx-swap="outerHTML"
    hx-disabled-elt="find input, find button"
  {% else %}
    onsubmit="event.preventDefault();this.querySelector('#shipping_select_sku_msg').classList.remove('hidden')"
  {% endif %}
  class="flex flex-col mt-3"
>
  <span class="flex items-center justify-start text-base font-medium text-base-content mb-2.5">
    Consultar frete e prazo
  </span>
  <div class="flex flex-wrap items-center justify-start gap-x-3 gap-y-2 w-full">
    <input-mask class="">
      <input 
        class="input input-md w-full min-w-28" 
        type="text" 
        name="zipcode" 
        placeholder="00000-000" 
        pattern="[0-9]{5}-[0-9]{3}" 
        inputmode="numeric" 
        required 
        data-mask="zipcode"
        data-testid="li-product-freight-input"
        oninput="if(this.value.length===9){this.form.requestSubmit();}"
        onchange="if(this.value.length===9){this.form.requestSubmit();}"
        />
    </input-mask>
    <button type="submit" class="shrink-0 mr-2 relative btn btn-secondary btn-ghost btn-md" data-testid="li-product-freight-submit">
      Calcular
      <span id="prod-shipping-spinner" class="hidden [&.htmx-request]:flex absolute inset-0 size-full flex-wrap justify-center content-center bg-black/50 rounded-field">
        <svg class="fill-current animate-spin size-4" role="img" aria-hidden="true">
          <use xlink:href="/static/img/fontawesome-solid.svg#spinner" href="/static/img/fontawesome-solid.svg#spinner"></use>
        </svg>
      </span>
    </button>
    <a class="shrink-0 link hover:opacity-70 text-xs" href="/nao_sei_o_cep/" target="_blank">Não sei o meu CEP</a>
  </div>
  <div id="prod-shipping-result" class="text-sm">
    {% unless selected_sku %}
      <div id="shipping_select_sku_msg" class="hidden mt-3 p-5 rounded-lg border border-base-200 text-center text-sm transition-discrete" aria-hidden="true">
        Antes de calcular o frete é necessário escolher as opções do produto.
      </div>
    {% endunless %}
  </div>
</form>
