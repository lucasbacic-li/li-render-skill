{%- capture buy_together_item_box_class -%}
  {%- if is_layout_list -%}
    w-full gap-4 {% if is_first %}md:flex-col md:gap-2 md:w-1/2 md:w-36{% else %}md:flex-row{% endif %}
  {%- else -%}
    flex-col gap-2 w-36
  {%- endif -%}
{%- endcapture -%}
{%- assign product = item.product -%}
{%- capture variationsMap -%}
  {
    {%- for product_sku in product.skus -%}
      {%- if product_sku.variations and product_sku.available and product_sku.price.upon_request != true -%}
        {%- assign variations_ordered = product_sku.variations | sort: 'option.id' -%}
        '
          {%- for variation in variations_ordered -%}
            {%- unless forloop.first -%}
              --            
            {%- endunless -%}
            {{ variation.option.id }}-{{ variation.value.id }}
          {%- endfor -%}
        ': '{{ product_sku.id }}'
        {%- unless forloop.last -%}, {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  }
{%- endcapture -%}
{%- assign price = product.selected_sku.price | default: product.price -%}
<buy-together-product
  class="flex-none flex relative opacity-70 grayscale has-[input[type='checkbox']:checked]:opacity-100 has-[input[type='checkbox']:checked]:grayscale-0 {{ buy_together_item_box_class }}"
  id="{{ buy_together_string_id }}-product-{{ product.id }}"
  data-testid="li-buytogether-item{% if is_first %}-current{% endif %}"
  data-variations-map="{{ variationsMap }}"
  data-selected="{{ item.selected | default: false }}"
  data-selected-sku="{{ product.selected_sku.id }}"
  data-has-options="{{ product.options.size > 0 }}"
  data-is-first="{{ is_first | default: false }}"
  data-mt-prod-id="{{ product.id }}"
  data-mt-prod-sku="{{ product.code }}"
  data-mt-prod-name="{{ product.name }}"
  data-mt-prod-price="{{ price.base | default: price.selling }}"
  data-mt-prod-promotional-price="{{ price.selling }}"
>
  {% unless is_last %}
    <div class="absolute {% if is_layout_list %}inset-x-0 -bottom-px -mb-8 {% if is_first %}md:inset-x-auto md:bottom-0 md:mb-0 md:inset-y-0 md:-right-px md:-mr-8{% endif %}{% else %}inset-y-0 -right-px -mr-8{% endif %} flex items-center justify-center">
      <span class="p-1.5 bg-base-200 rounded-full">
        <svg class="fill-current size-4" role="img" aria-hidden="true">
          <use xlink:href="/static/img/fontawesome-solid.svg#plus" href="/static/img/fontawesome-solid.svg#plus"></use>
        </svg>
      </span>
    </div>
  {% endunless %}
  <div class="flex-none flex items-center mx-auto w-full {% if is_layout_list and is_first != true %}max-w-20 max-h-20{% else %}max-w-36 max-h-36{% endif %} relative">
    {%- assign specification_image = product.selected_sku.specification_images[0] -%}
    {%- if specification_image -%}
      {%- for image in product.images -%}
        {%- if image.id == specification_image -%}
          {%- assign img_url = image.path -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- assign img_url = img_url | default: product.preview_images[0] | default: '/0/0/common/product-no-image.gif' -%}
    <img
      src="{{ img_url | prepend: '/150x150' | prepend: ctx.static_domain }}"
      srcset="
        {{ img_url | prepend: '/80x80' | prepend: ctx.static_domain }} 80w,
        {{ img_url | prepend: '/100x100' | prepend: ctx.static_domain }} 100w,
        {{ img_url | prepend: '/120x120' | prepend: ctx.static_domain }} 120w,
        {{ img_url | prepend: '/150x150' | prepend: ctx.static_domain }} 150w,
        {{ img_url | prepend: '/200x200' | prepend: ctx.static_domain }} 200w,
        {{ img_url | prepend: '/250x250' | prepend: ctx.static_domain }} 250w,
        {{ img_url | prepend: '/300x300' | prepend: ctx.static_domain }} 300w"
      alt="{{ product.name }}"
      class="object-contain w-full h-full rounded-box"
      width="150"
      height="150"
      loading="lazy"
    />
    <div class="absolute top-0 right-0">
      {% if is_first %}
        <p class="badge badge-primary text-base mt-1.5 mr-2.5">Atual</p>
      {% endif %}
      <label class="flex items-center justify-center cursor-pointer size-9 {% if is_first %}hidden{% endif %}" data-toggle-link="/partial/product/buytogether?{{ item.toggle_link }}">
        <input type="checkbox" name="check_selected_sku" value="{{ product.selected_sku.id }}" class="checkbox checkbox-primary accent-primary cursor-pointer disabled:pointer-events-none" {% if item.selected %}checked{% endif %} />
        <span class="sr-only">Selecionar produto</span>
      </label>
    </div>
  </div>
  <div class="mt-1 flex-1 flex flex-col gap-3 {% if is_layout_list and is_first == false %}justify-center{% endif %}">
    <a href="{{ product.url }}" class="hover:opacity-70">
      <h3 class="break-words font-medium text-sm text-base-content">{{ product.selected_sku.name | default: product.name }}</h3>
    </a>
    {% if product.options.size > 0 %}
      <div class="mb-1 flex flex-col gap-2">
        {% for variation in product.options %}
          {%- assign is_option_colors = false -%}
          {%- for option in variation.values -%}
            {%- if option.swatch.color -%}
              {%- assign is_option_colors = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if is_option_colors -%}
            <div class="flex flex-wrap gap-2 items-center overflow-hidden has-disabled:opacity-50 has-disabled:pointer-events-none">
              {% for option in variation.values %}
                <label
                  class="group relative size-5.5 border border-base-200 rounded-md flex items-center justify-center self-stretch cursor-pointer hover:bg-base-200 has-checked:bg-primary-content has-checked:border-primary transition-all duration-200 overflow-hidden"
                  title="Opção {{ option.name }}"
                >
                  <input
                    type="radio"
                    name="bt_variation_{{ variation.option.id }}"
                    value="{{ option.id }}"
                    class="peer sr-only"
                    {% if option.selected %}checked{% endif %}
                  />
                  <span class="sr-only">{{ option.name }}</span>
                  <span aria-hidden="true" class="size-5.5 block" style="background: linear-gradient(135deg, {{ option.swatch.color.primary }} 50%, {{ option.swatch.color.secondary | default: option.swatch.color.primary }} 50%);"></span>
                </label>
              {% endfor %}
            </div>
          {%- else -%}
            <label>
              <span class="sr-only">{{ variation.option.display_name }}:</span>
              <select
                name="bt_variation_{{ variation.option.id }}"
                class="w-full border-base-200 border px-4 py-2.5 rounded-box"
              >
                <option value="">Selecione {{ variation.option.display_name }}</option>
                {% for option in variation.values %}
                  <option value="{{ option.id }}" {% if option.selected %}selected{% endif %}>{{ option.name }}</option>
                {% endfor %}
              </select>
            </label>
          {%- endif -%}
        {% endfor %}
      </div>
    {% endif %}
    <div class="flex flex-col text-left">
      {% if price.base and price.base > price.selling %}
        <span class="text-base-content/50 text-xs"><span class="line-through" data-testid="li-buytogether-item-price-base">{{ price.base | format_number: "C" }}</span></span>
      {% endif %}
      <strong class="font-medium text-base text-base-content" data-testid="li-buytogether-item-price-selling">{{ price.selling | format_number: "C" }}</strong>
    </div>
  </div>
</buy-together-product>
