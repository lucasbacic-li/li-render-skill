{%- assign add_to_cart_url = routes.cart_item | append: '/' | append: selected_sku.id | append: '/add' -%}
{%- assign select_variation_text = 'Selecione uma variação para continuar' -%}
{%- assign quantity_input_id = 'prod_qtd_add' -%}
{%- if is_floating -%}
  {%- assign quantity_input_id = quantity_input_id | append: '-floating' -%}
{%- endif -%}
{%- assign decrease_btn_id = 'decrease-qty-btn' -%}
{%- assign increase_btn_id = 'increase-qty-btn' -%}

<form
  class="flex items-center justify-between gap-2"
  onsubmit="event.preventDefault();"
>
  {% if layout_attributes.configuracao.qtde_adicionar_carrinho %}
    <div class="flex items-center justify-center min-w-24">
      <div class="input input-lg px-3 gap-0">
        <label class="sr-only" for="{{ quantity_input_id }}">Quantidade:</label>
        <button 
          type="button" 
          id="{{ decrease_btn_id }}"
          class="-ml-px btn btn-square btn-ghost btn-lg px-0 w-6" 
          title="Diminuir quantidade"
          disabled
          onclick="
            const input = document.getElementById('{{ quantity_input_id }}');
            input.value--;
            input.dispatchEvent(new Event('change'));
          "
        >
          <svg class="fill-current size-3" role="img" aria-hidden="true">
            <use xlink:href="/static/img/fontawesome-solid.svg#minus" href="/static/img/fontawesome-solid.svg#minus"></use>
          </svg>
        </button>
        <input
          class="validator text-base font-medium text-center [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
          type="number"
          name="quantity"
          id="{{ quantity_input_id }}"
          value="1"
          min="1"
          max="9999"
          step="1"
          required
          oninput="
            clearTimeout(this.debounceTimer);
            this.debounceTimer = setTimeout(() => {
              this.dispatchEvent(new Event('change'));
            }, 10);
          "
          onchange="
            const value = Math.floor(parseInt(this.value) || 1);
            const clampedValue = Math.max(1, Math.min(9999, value));
            this.value = clampedValue;
            this.setAttribute('value', this.value);
            const decreaseBtn = document.getElementById('{{ decrease_btn_id }}');
            const increaseBtn = document.getElementById('{{ increase_btn_id }}');
            decreaseBtn.disabled = clampedValue <= 1;
            increaseBtn.disabled = clampedValue >= 9999;
            document.getElementById('btn-add-to-cart').href = '{{ add_to_cart_url }}' + '/' + clampedValue;
          "
          onfocus="this.select()"
        />
        <button 
          type="button" 
          id="{{ increase_btn_id }}"
          class="-mr-px btn btn-square btn-ghost btn-lg px-0 w-6" 
          title="Aumentar quantidade"
          onclick="
            const input = document.getElementById('{{ quantity_input_id }}');
            input.value++;
            input.dispatchEvent(new Event('change'));
          "
        >
          <svg class="fill-current size-3" role="img" aria-hidden="true">
            <use xlink:href="/static/img/fontawesome-solid.svg#plus" href="/static/img/fontawesome-solid.svg#plus"></use>
          </svg>
        </button>
      </div>
    </div>
  {% endif %}
  <div
    class="relative w-full tooltip tooltip-primary before:max-w-full"
    {% unless selected_sku %}
      data-tip="{{ select_variation_text }}"
    {% endunless %}
  >
    <a
      id="btn-add-to-cart"
      class="btn btn-block btn-primary btn-lg leading-4 text-sm md:text-base {% unless selected_sku %}btn-disabled{% endunless %}"
      data-testid="li-product-buy"
      {% if selected_sku %}
        href="{{ add_to_cart_url }}"
        hx-post="{{ add_to_cart_url }}"
        hx-swap="none show:window:top"
        hx-push-url="false"
        hx-indicator="#btn-add-to-cart-{{ selected_sku.id }}-spinner"
        hx-include="#{{ quantity_input_id }}"
        hx-disabled-elt="find button"
      {% else %}
        aria-disabled="true"
        title="{{ select_variation_text }}"
      {% endif %}
    >
      {{- layout_attributes.configuracao.texto_botao_comprar | default: 'Adicionar ao carrinho' }}
      <svg class="text-primary" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 12C0 5.37258 5.37258 0 12 0C18.6274 0 24 5.37258 24 12C24 18.6274 18.6274 24 12 24C5.37258 24 0 18.6274 0 12Z" fill="white"/>
        <mask id="mask0_541_8703" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
          <rect width="24" height="24" fill="#D9D9D9"/>
        </mask>
        <g mask="url(#mask0_541_8703)">
          <path d="M13.625 17L12.4875 15.7917L15.3719 12.8333H5.5V11.1667H15.3719L12.4875 8.20833L13.625 7L18.5 12L13.625 17Z" fill="currentColor"/>
        </g>
      </svg>

      <span id="btn-add-to-cart-{{ selected_sku.id }}-spinner" class="htmx-indicator opacity-0 absolute inset-0 bg-base-content/10 flex items-center justify-center">
        <svg class="fill-current animate-spin size-5" role="img" aria-hidden="true">
          <use xlink:href="/static/img/fontawesome-solid.svg#spinner" href="/static/img/fontawesome-solid.svg#spinner"></use>
        </svg>
      </span>
    </a>
  </div>
</form>
