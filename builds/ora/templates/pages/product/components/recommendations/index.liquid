
{% if props.async or async %}
  <div
    id="product-recommendations"
    hx-get="/partial/product/recommendations?product_id={{ data.product.id }}"
    hx-trigger="revealed once"
    hx-swap="outerHTML"
    hx-select="#product-recommendations"
  ></div>
{% else %}
  {%- if data.recommendations.products.size > 0 -%}
    <div id="product-recommendations" class="ora-pdp-recos">
      {% comment %} Sem override de slides_per_view → herda o default (mobile 1.2 = 1 largo + corte). {% endcomment %}
      {% render 'shared/components/shelf/index',
        products: data.recommendations.products,
        title: 'Talvez você pode se interessar por',
        shelf_type: 'carousel'
      %}
    </div>
  {%- endif -%}
{% endif %}
