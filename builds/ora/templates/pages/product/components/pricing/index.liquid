{%- comment -%}
  Linha de preço em 3 células (ref. Paper). Responsividade por CONTAINER QUERY
  (largura do rail, não da viewport): empilha em 3 linhas quando o rail é estreito
  (mobile/tablet 50%), vira 3 colunas quando há largura — ver `@container pdp-summary`
  no theme.css. Base do markup = empilhado (flex-col + border-t).
{%- endcomment -%}
{%- assign price_varies = data.product.price_varies and data.product.selected_sku == null -%}
{%- assign installment = price.best_payment_condition.installment -%}

<div class="ora-pdp-pricerow flex flex-col border-b border-[color:var(--ora-line-2)] font-[family-name:var(--ora-font-mono)]">
  {%- comment -%} Célula 1 — preço {%- endcomment -%}
  <div class="ora-pdp-pricerow__price flex flex-col justify-center gap-0.5 pt-4 pb-2">
    {% if price.base and price.base > price.selling %}
      <span class="text-xs text-base-content/60 line-through" data-testid="li-product-price-base">{{ price.base | format_number: "C" }}</span>
    {% endif %}
    <strong class="font-normal text-xl leading-none text-[color:var(--ora-espresso)]" data-testid="li-product-price-selling">
      {% if price_varies %}<span class="text-sm font-normal text-base-content/70">a partir de </span>{% endif %}{{ price.selling | format_number: "C" }}
    </strong>
  </div>

  {%- comment -%} Célula 2 — parcelamento {%- endcomment -%}
  {% if installment %}
    <div class="ora-pdp-pricerow__inst flex items-center pb-3 text-xs leading-snug text-[color:var(--ora-argila)]">
      <span><strong class="font-normal">{{ installment.installment_number }}x</strong> de <strong class="font-normal">{{ installment.installment_value | format_number: "C" }}</strong>{% if installment.no_rate %} sem juros{% endif %}</span>
    </div>
  {% endif %}

  {%- comment -%} Célula 3 — formas de pagamento (abre o modal) {%- endcomment -%}
  <button
    type="button"
    class="ora-pdp-pricerow__pay flex items-center pb-4 text-xs leading-snug text-[color:var(--ora-argila)] underline underline-offset-4 decoration-1 transition-colors hover:text-primary"
    onclick="product_payments_modal.showModal()"
  >
    formas de pagamento
  </button>
</div>
