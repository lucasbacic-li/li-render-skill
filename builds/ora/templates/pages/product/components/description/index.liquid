{% if data.product.description and data.product.description != "" %}
  {%- comment -%}
    "Sobre o produto": o bloco bordado (border-t/b) envolve título + corpo —
    o corpo da descrição vive DENTRO do mesmo componente (ref. Paper 4QR-0).
    Corpo em mono noz; chevron gira ao abrir.
  {%- endcomment -%}
  <div class="collapse ora-sobre border-t border-b border-[color:var(--ora-line-2)]">
    <input type="checkbox" name="description-accordion" {% unless rail %}checked{% endunless %} aria-label="Expandir descrição do produto" />
    <div class="collapse-title">
      <div class="flex items-center justify-between gap-8 py-4">
        <span class="ora-sheet-title">Sobre o produto</span>
        <span class="ora-sobre__chevron material-symbols-sharp text-[color:var(--ora-noz)]" aria-hidden="true">chevron_right</span>
      </div>
    </div>
    <div class="collapse-content">
      <div class="ora-sobre__body pb-4 font-[family-name:var(--ora-font-mono)] text-sm leading-relaxed text-[color:var(--ora-noz)]" hx-disable>
        {{ data.product.description | sanitize | raw }}
      </div>
    </div>
  </div>
{% endif %}

{% appsection after_product_description %}
