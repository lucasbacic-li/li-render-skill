{% assign product_id = ctx.url.querystring.product_id | default: product_id %}

<bottom-sheet-dialog class="bottom-sheet active">
  <div 
    class="bottom-sheet-overlay bottom-sheet-close"
  ></div>
  
  <div class="bottom-sheet-content bottom-sheet-content-dialog">
    <div id="upon-request-container" class="p-6 bg-base-100 flex flex-col gap-6">
      <form
        id="upon-request-form"
        method="post"
        hx-post="{{ routes.catalog_product_onrequest | replace: '{product_id}', product_id }}"
        hx-target="#upon-request-form-result"
        hx-swap="innerHTML"
        hx-disabled-elt="find button, find input"
        class="flex flex-col gap-4"
      >
        <div class="flex flex-col">
          <div class="flex items-center justify-between">
            <h3 class="ora-sheet-title">Consultar preço</h3>
            <button 
              type="button"
              class="bottom-sheet-close"
            >
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <mask id="mask0_coupon_close" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="20" height="20">
                <rect width="20" height="20" fill="#D9D9D9"/>
                </mask>
                <g mask="url(#mask0_coupon_close)">
                <path d="M5.33317 15.8334L4.1665 14.6667L8.83317 10.0001L4.1665 5.33341L5.33317 4.16675L9.99984 8.83341L14.6665 4.16675L15.8332 5.33341L11.1665 10.0001L15.8332 14.6667L14.6665 15.8334L9.99984 11.1667L5.33317 15.8334Z" fill="currentColor"/>
                </g>
              </svg>
            </button>
          </div>
          <span class="text-base leading-6 text-base-content">
            Deixe seu nome, e-mail e telefone que te enviaremos o valor do produto.
          </span>
        </div>
        <div id="upon-request-form-result" class="flex flex-col gap-4">
          <div class="flex-1">
            <label for="upon-request-name" class="sr-only">Nome</label>
            <input
              id="upon-request-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              class="input input-md input-bordered w-full"
              placeholder="Nome"
              data-testid="li-uponrequest-name"
            />
          </div>
          <div class="flex-1">
            <label for="upon-request-email-address" class="sr-only">E-mail</label>
            <input
              id="upon-request-email-address"
              name="email"
              type="email"
              autocomplete="email"
              required
              class="input input-md input-bordered w-full"
              placeholder="E-mail"
              data-testid="li-uponrequest-email"
            />
          </div>
          <div class="flex-1">
            <label for="upon-request-phone-number" class="sr-only">Telefone</label>
            <input-mask>
              <input
                id="upon-request-phone-number"
                name="phone_number"
                type="tel"
                autocomplete="tel"
                required
                data-mask="phone"
                pattern="\(\d{2}\) \d{4,5}-\d{4}"
                class="input input-md input-bordered w-full"
                placeholder="Telefone"
                data-testid="li-uponrequest-phone"
              />
            </input-mask>
          </div>
        </div>
        
        <button type="submit" class="btn btn-md btn-primary btn-block" data-testid="li-uponrequest-submit">
          Solicitar
        </button>
      </form>
    </div>
  </div>
</bottom-sheet-dialog>

<script defer src="{% asset_url '/scripts/bottom-sheet-dialog.webc.js' %}"></script>
