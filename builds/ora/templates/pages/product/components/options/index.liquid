{% assign product_options = data.product.options %}
{% if product_options and product_options.size > 0 %}
  {% assign product_images = data.product.images %}
  {% assign options_param_sep = '..' %}
  
  <product-sku-selector class="block">
    <form
      id="prod-variations-selector-form"
      class="relative flex flex-col gap-4 transition-opacity duration-100"
      hx-get
      hx-params="selected_variation[]"
      hx-trigger="li-prod-options-selected delay:200ms"
      {% if target_id %}
        hx-target="#{{ target_id }}"
        hx-select="#product-summary #product-buy-button-container"
        hx-swap="innerHTML"
      {% else %}
        hx-replace-url="true"
        hx-target="#product-summary"
        hx-select="#product-summary"
        hx-swap="outerHTML"
      {% endif %}
      hx-indicator="#prod-variations-selector-spinner"
      hx-on::before-request="this.classList.add('opacity-40', 'pointer-events-none')"
      hx-on::after-request="this.classList.remove('opacity-40', 'pointer-events-none')"

      onsubmit="event.preventDefault()"
    >
      {%- for variation in product_options -%}
        {%- assign variation_id = variation.option.id -%}
        {%- assign variation_name = variation.option.display_name -%}
        {%- assign variation_ref = variation_name | append: options_param_sep | append: variation_id -%}

        <fieldset 
          data-variation-ref="{{ variation_ref }}"
          data-variation-selected="{{ variation.selected_value }}"
          class="border-b border-base-200 pb-5 last:border-b-0 last:pb-0"
        >
          <legend class="text-sm font-medium mb-3 font-[family-name:var(--ora-font-mono)] text-[color:var(--ora-noz)]">Selecione a opção de {{ variation.option.display_name }}:</legend>
          <input type="hidden" name="selected_variation[]" id="{{ variation_ref }}" />
          <div class="flex flex-wrap items-center gap-3">
            {%- for option in variation.values -%}
              {%- assign option_ref = option.name | append: options_param_sep | append: option.id -%}
              <label
                data-related-images="{{ option.related_images | json }}"
                class="ora-variation-opt group relative shrink flex flex-wrap flex-col md:flex-row items-center justify-center gap-1 min-h-12 px-6 pt-4 pb-3.5 cursor-pointer focus:outline-hidden has-disabled:cursor-not-allowed has-disabled:opacity-50 data-[color-selector=true]:p-1 data-[color-selector=false]:min-w-20 transition-all duration-300"
                title="{{ variation.option.display_name }} {{ option.name }}"
                data-testid="li-product-variation-option"
                data-color-selector="{% if option.swatch.color %}true{% else %}false{% endif %}"
              >
                <input
                  type="radio"
                  name="{{ variation_ref }}"
                  value="{{ option_ref }}"
                  class="peer sr-only product-variation-option-input"
                  {% if option.selected %}checked{% endif %}
                />
                {% comment %} {%- for image in product_images -%}
                  {%- if option.related_images contains image.id -%}
                    <span class="shrink size-12 -mt-1 md:mt-0 md:-ml-1">
                      <img class="size-full object-contain p-1 rounded-selector" src="{{ ctx.static_domain }}/40x40{{ image.path }}" alt="{{ option.name }}" loading="lazy" />
                    </span>
                    {% break %}
                  {%- endif -%}
                {%- endfor -%} {% endcomment %}
                <span
                  id="prod-{{ product.id }}-variation-{{ variation_id }}-choice-{{ option.id }}-label"
                  class="shrink break-words text-xs font-medium leading-5 block text-center md:text-left {% if option.swatch.color %}sr-only{% endif %}"
                >
                  {{- option.name -}}
                </span>
                {%- if option.swatch.color -%}
                  <span class="flex rounded-md overflow-hidden">
                    {%- if option.swatch.color -%}
                      <span aria-hidden="true" class="size-10" style="background-color: {{ option.swatch.color.primary }};"></span>
                      {%- if option.swatch.color.secondary -%}
                        <span aria-hidden="true" class="size-10" style="background-color: {{ option.swatch.color.secondary }};"></span>
                      {%- endif -%}
                    {%- endif -%}
                  </span>
                {%- endif -%}
              </label>
            {%- endfor -%}
          </div>
        </fieldset>
      {%- endfor -%}
    </form>
    <script type="application/json" data-skus>
    [
      {%- for sku in data.product.skus -%}
      {
        "id": "{{ sku.id }}",
        "code": "{{ sku.code }}",
        "active": {{ sku.active }},
        "available": {{ sku.available }},
        "variations": [
          {%- for variation in sku.variations -%}
          {
            "option": {
              "id": "{{ variation.option.id }}",
              "display_name": "{{ variation.option.display_name }}"
            },
            "value": {
              "id": "{{ variation.value.id }}",
              "name": "{{ variation.value.name }}"
            }
          }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
    </script>
  </product-sku-selector>

  <script defer src="{% asset_url '/scripts/product-sku-selector.webc.js' %}"></script>
{% endif %}
