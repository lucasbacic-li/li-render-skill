{%- assign rating_average = rating | default: 0 | plus: 0.0 -%}
{%- assign rating_size = size | default: 'rating-md' -%}
{%- if size == 'xs' -%}
  {%- assign rating_size = 'rating-xs' -%}
{%- elsif size == 'sm' -%}
  {%- assign rating_size = 'rating-sm' -%}
{%- elsif size == 'lg' -%}
  {%- assign rating_size = 'rating-lg' -%}
{%- elsif size == 'xl' -%}
  {%- assign rating_size = 'rating-xl' -%}
{%- endif -%}
<span class="rating rating-half {{ rating_size }}" aria-label="Avaliação: {{ rating }} de 5 estrelas" role="img">
  {%- for i in (1..10) -%}
    {%- assign mask_class = 'mask-half-1' -%}
    {%- assign i_mod_2 = i | modulo: 2 -%}
    {%- if i_mod_2 == 0 -%}
      {%- assign mask_class = 'mask-half-2' -%}
    {%- endif -%}
    {%- assign star_value = i | times: 0.5 -%}
    {%- assign lower_bound = star_value | minus: 0.25 -%}
    {%- assign upper_bound = star_value | plus: 0.25 -%}
    {%- if i == 1 -%}
      {%- assign lower_bound = 0 -%}
    {%- endif -%}
    <span class="mask mask-star-2 {{ mask_class }} bg-orange-300" aria-current="{%- if rating_average > lower_bound and rating_average <= upper_bound -%}true{%- endif -%}" aria-hidden="true"></span>
  {%- endfor -%}
</span>
