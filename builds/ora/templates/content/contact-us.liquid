{%- assign social_instagram = data.store.social_networks.instagram -%}
<section id="contact-us" class="ora-contact container">
  {%- comment -%} ESQUERDA — voz da marca + canais diretos (alternativa ao form) {%- endcomment -%}
  <div class="ora-contact__voice">
    <p class="ora-eyebrow">Contato</p>
    <h2 class="ora-contact__statement">
      <span class="ora-serif">Dúvidas, ideias</span>
      <span class="ora-grotesk">ou só um oi?</span>
    </h2>
    <p class="ora-contact__lead">Estamos aqui pra ouvir você — sobre um pedido, uma troca ou só pra dizer oi.</p>
    <ul class="ora-contact__channels">
      {% if data.store.email %}
        <li><a href="mailto:{{ data.store.email }}" class="ora-cta-text">{{ data.store.email }}</a></li>
      {% endif %}
      {% if data.store.whatsapp %}
        <li><a href="https://wa.me/55{{ data.store.whatsapp | only_numbers }}" target="_blank" rel="noopener" class="ora-cta-text">WhatsApp · {{ data.store.whatsapp | format_phone }}</a></li>
      {% endif %}
      {% if data.store.phone %}
        <li><a href="tel://{{ data.store.phone | only_numbers }}" class="ora-cta-text">{{ data.store.phone | format_phone }}</a></li>
      {% endif %}
      {% if social_instagram %}
        <li><a href="https://www.instagram.com/{{ social_instagram }}" target="_blank" rel="noopener" class="ora-cta-text">@{{ social_instagram }}</a></li>
      {% endif %}
    </ul>
  </div>

  {%- comment -%} DIREITA — formulário (rota + hx-post do litheme intactos) {%- endcomment -%}
  <div class="ora-contact__form-col">
    <form
      id="contact-us-form"
      method="post"
      action="{{ routes.contact_us }}"
      hx-post="{{ routes.contact_us }}"
      hx-select="#contact-us-form"
      hx-swap="outerHTML show:top"
      hx-indicator="#contact-us-spinner"
      hx-disabled-elt="find button, input, find textarea"
    >
      {% if data.contact_us.success %}
        <div class="ora-contact__success">
          <svg class="fill-current size-10 mb-5" role="img" aria-hidden="true">
            <use xlink:href="/static/img/fontawesome-solid.svg#check" href="/static/img/fontawesome-solid.svg#check"></use>
          </svg>
          <p class="ora-serif">Mensagem enviada.</p>
          <p>Em breve entraremos em contato.</p>
        </div>
      {% else %}
        <div class="ora-contact__fields">
          <div>
            <label for="contact_us-name" class="ora-label block mb-2">Nome *</label>
            <input hx-preserve type="text" id="contact_us-name" name="name" class="input w-full" required maxlength="100" />
          </div>
          <div>
            <label for="contact_us-email" class="ora-label block mb-2">E-mail *</label>
            <input hx-preserve type="email" id="contact_us-email" name="email" class="input w-full" required maxlength="128" />
          </div>
          <div>
            <label for="contact_us-phone" class="ora-label block mb-2">Telefone *</label>
            <input-mask>
              <input hx-preserve type="tel" id="contact_us-phone" name="phone_number" class="input w-full" required maxlength="15" pattern="\(\d{2}\) \d{4,5}-\d{4}" data-mask="phone" />
            </input-mask>
          </div>
          <div>
            <label for="contact_us-order" class="ora-label block mb-2">Número do pedido</label>
            <input hx-preserve type="text" id="contact_us-order" name="order" class="input w-full" maxlength="50" />
          </div>
          <div class="ora-contact__field--full">
            <label for="contact_us-message" class="ora-label block mb-2">Mensagem *</label>
            <textarea hx-preserve id="contact_us-message" name="message" class="textarea w-full" required maxlength="5000" rows="6"></textarea>
          </div>
          {%- assign politica_privacidade_pagina = layout_attributes.configuracao.politica_privacidade_pagina | plus: 0 -%}
          {%- assign politica_privacidade = data.institutional_pages | where: 'id', politica_privacidade_pagina | first -%}
          {% if layout_attributes.configuracao.politica_privacidade_contato and politica_privacidade %}
            <div class="ora-contact__field--full">
              <label class="flex items-center gap-3">
                <input type="checkbox" name="accept_terms" class="accent-primary" required />
                <span class="ora-mono">Li e concordo com os termos da <a href="/pagina/{{ politica_privacidade.url }}" target="_blank" class="link">Política de Privacidade</a>.</span>
              </label>
            </div>
          {% endif %}
        </div>
        {% comment %} #TODO: RECAPTCHA {% endcomment %}
        <div class="ora-contact__actions">
          <button type="submit" class="ora-cta relative">
            <span class="ora-cta__label">Enviar</span>
            <span class="ora-cta__box">
              <svg role="img" aria-hidden="true">
                <use xlink:href="/static/img/fontawesome-solid.svg#arrow-right" href="/static/img/fontawesome-solid.svg#arrow-right"></use>
              </svg>
            </span>
            <span id="contact-us-spinner" class="hidden [&.htmx-request]:flex absolute inset-0 size-full flex-wrap justify-center content-center bg-base-content/10">
              <svg class="fill-current animate-spin size-4" role="img" aria-hidden="true">
                <use xlink:href="/static/img/fontawesome-solid.svg#spinner" href="/static/img/fontawesome-solid.svg#spinner"></use>
              </svg>
            </span>
          </button>
        </div>
        {% if data.contact_us.success == false %}
          <div class="ora-contact__error">
            {{ data.contact_us.message|default: 'Erro ao enviar a mensagem. Recarregue a página e tente novamente.' }}
          </div>
        {% endif %}
      {% endif %}
    </form>
  </div>
</section>

