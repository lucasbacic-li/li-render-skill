<div id="prod-shipping-result" class="mt-3 text-sm transition-discrete">
  {% if data.deliveries.size > 0 %}
    <ul class="rounded-lg border border-base-200">
      {% for delivery in data.deliveries %}
      <li class="px-5 py-2 hover:bg-base-100">
        <div class="flex items-center gap-3">
          <span class="shrink-0 font-semibold text-nowrap">{{ delivery.price | format_number: "C"}}</span>
          <span class="grow break-words text-xs text-base-content/70">{{ delivery.name }}</span>
          <span class="shrink-0 text-nowrap text-right">{{ delivery.delivery_time }} {{ delivery.delivery_time | pluralize: 'dia útil', 'dias úteis' }}</span>
        </div>
        {% if delivery.msg_erro %}
          <p class="mt-1 text-xs text-base-content/70">
            {{ delivery.msg_erro }}
          </p>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
    <p class="text-xs leading-3 mt-3 text-base-content/70">
      * Este prazo de entrega está considerando a disponibilidade do produto + prazo de entrega.
    </p>
  {% else %}
    <div class="p-5 rounded-lg border border-base-200 text-center font-semibold text-base-content/70">
      Não foram encontradas formas de envio para o CEP informado.
    </div>
  {% endif %}
</div>

{% render 'shared/utils/cart-message' %}
