<script type="text/javascript" id="toast-trigger" hx-swap-oob="true">
  {% if data.cart.marketing.cupom.id %}
    if (typeof window.toast === 'function') window.toast('Cupom aplicado', {type: 'success'});
    (function() {
      let couponPortal = document.getElementById('coupon-portal');
      if(couponPortal) couponPortal.innerHTML = '';
    })();
  {% endif %}
</script>

{% render 'shared/utils/cart-message' %}
