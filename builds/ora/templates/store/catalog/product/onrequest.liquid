{% if data.onrequest.success %}
  <div id="upon-request-form" class="upon-request-result flex flex-col gap-3 my-3" hx-swap-oob="true" data-testid="li-uponrequest-success">
    <div class="flex flex-col">
      <h3 class="ora-sheet-title">Solicitação enviada!</h3>
      <span class="text-base leading-6 text-base-content">
        Em breve você receberá um e-mail com mais informações sobre este produto
      </span>
    </div>
    <button type="button" class="btn btn-md btn-block" onclick="this.closest('bottom-sheet-dialog')?.close()">
      Fechar
    </button>
  </div>
{% endif %}

<script type="text/javascript" id="toast-trigger" hx-swap-oob="true">
  if (typeof window.toast === 'function') {
    {%- if data.onrequest.success -%}
      window.toast('Solicitação enviada com sucesso', {type: 'success'});
    {%- else -%}
      window.toast('Erro ao enviar solicitação. Tente novamente', {type: 'danger'});
    {%- endif -%}
  };
</script>
